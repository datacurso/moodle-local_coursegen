# Normalise line endings: all text files use LF in the repo and on checkout.
* text eol=lf

# Binary files: never normalise or diff as text.
*.png binary
*.jpg binary
*.gif binary
*.svg text eol=lf
*.pdf binary
*.zip binary

# Development-only paths excluded from release archives (git archive).
.github export-ignore
.gitattributes export-ignore
.gitignore export-ignore
Jenkinsfile.moodleplugin export-ignore
_docs export-ignore
