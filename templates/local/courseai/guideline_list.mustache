{{!
    @template local_coursegen/local/courseai/guideline_list

    Institutional guidelines popover list on the course AI creation page.
    Renders the whole <ul class="pop-list" id="guidelineList"> listbox so the
    template is a valid document fragment on its own. It is rendered once from
    the page template (empty) and re-rendered from JavaScript into the
    [data-region="guideline-list"] wrapper, replacing the <ul> each time.
    Visible strings are passed in as context.

    Classes required for JS:
    * pop-item on each list item (kept for CSS and Behat)

    Data attributes required for JS:
    * data-id on each item, data-select on the select button and
      data-preview on the eye button, all holding the guideline id;
      click handling is delegated on the wrapper region.

    Context variables required for this template:
    * listlabel string - Accessible name (aria-label) of the listbox
    * hasitems bool    - True when items is non-empty
    * items array      - Guidelines, each with: id string, name string,
                         category string, selected bool
    * viewtitle string - Title attribute of the preview (eye) button
    * emptytext string - Message shown when there are no items

    Example context (json):
    {
        "listlabel": "Guidelines list",
        "hasitems": true,
        "items": [
            {"id": "7", "name": "Quality policy", "category": "General", "selected": true},
            {"id": "9", "name": "Tone of voice", "category": "Style", "selected": false}
        ],
        "viewtitle": "View guideline",
        "emptytext": "No results"
    }
}}
<ul class="pop-list" id="guidelineList" role="listbox" aria-label="{{listlabel}}">
{{#hasitems}}
{{#items}}
<li class="pop-item{{#selected}} selected{{/selected}}" data-id="{{id}}">
    <button class="pop-select-btn" data-select="{{id}}" type="button">
        <div class="pop-radio"><div class="pop-dot"></div></div>
        <div class="pop-item-text">
            <span class="pop-item-name">{{name}}</span>
            <span class="pop-item-cat">{{category}}</span>
        </div>
    </button>
    <button class="pop-eye-btn" data-preview="{{id}}" type="button" title="{{viewtitle}}">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round"
            stroke-linejoin="round">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
        </svg>
    </button>
</li>
{{/items}}
{{/hasitems}}
{{^hasitems}}
<li class="pop-empty" role="presentation">{{emptytext}}</li>
{{/hasitems}}
</ul>
