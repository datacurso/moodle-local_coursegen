{{!
    @template local_coursegen/local/courseai/composer

    Main context composer of the AI course creation page: heading, prompt
    textarea, selected-context chips, the "+" options toolbar and the generate
    button. The chips and the toolbar are shared with the compact composer
    through the composer_chips and composer_toolbar partials.

    Classes required for JS:
    * none (elements are addressed by id)

    Data attributes required for JS:
    * see local_coursegen/local/courseai/composer_chips and composer_toolbar

    Context variables required for this template:
    * subsectionsenabled bool - Render the "with subsections" toggle
    * guidelinelist object - Context of local_coursegen/local/courseai/guideline_list

    Example context (json):
    {
        "subsectionsenabled": true,
        "guidelinelist": {
            "listlabel": "Guidelines list",
            "emptytext": "No results",
            "hasitems": false,
            "items": []
        }
    }
}}
<div class="courseai-context-editor" id="courseaiContextEditor">

  <div class="context-head">
    <h2>{{#str}}courseai_context_title, local_coursegen{{/str}}</h2>
    <p>{{#str}}courseai_context_subtitle, local_coursegen{{/str}}</p>
  </div>

  <div class="card" id="mainCard">

    <textarea
      id="promptInput"
      class="prompt-textarea"
      placeholder="{{#str}}courseai_prompt_placeholder, local_coursegen{{/str}}"
      rows="5"
      aria-label="{{#str}}courseai_prompt_arialabel, local_coursegen{{/str}}"
    ></textarea>

    {{> local_coursegen/local/courseai/composer_chips }}

    <div class="card-toolbar">
      <div class="tbar-left">
        {{> local_coursegen/local/courseai/composer_toolbar }}
      </div>

      <div class="tbar-right">
        <span class="kbd-hint">{{#str}}courseai_hint_enter, local_coursegen{{/str}}</span>
        <button class="btn-generate" id="btnGenerate" type="button">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
          </svg>
          {{#str}}courseai_btn_generate, local_coursegen{{/str}}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7"/>
          </svg>
        </button>
      </div>
    </div>

  </div>

  <p class="form-tip">{{#str}}courseai_form_tip, local_coursegen{{/str}}</p>

</div>
