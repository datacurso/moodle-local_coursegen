{{!
    @template local_coursegen/local/courseai/guideline_list_compact

    Items of the compact toolbar guidelines list on the course AI creation
    page. Rendered from JavaScript into the existing
    <ul class="pop-list" id="guidelineListCompact"> container, so this
    template outputs only <li> elements. An empty list renders nothing.

    Classes required for JS:
    * pop-item on each list item (click handling is delegated on the container)

    Data attributes required for JS:
    * data-id on each item, holding the guideline id

    Context variables required for this template:
    * items array - Guidelines, each with: id string, name string, selected bool

    Example context (json):
    {
        "items": [
            {"id": "7", "name": "Quality policy", "selected": true},
            {"id": "9", "name": "Tone of voice", "selected": false}
        ]
    }
}}
{{#items}}
<li class="pop-item{{#selected}} active{{/selected}}" role="option" data-id="{{id}}" tabindex="-1">
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
    </svg>
    <span class="pop-item-name">{{name}}</span>
    {{#selected}}<span class="pop-item-check">✓</span>{{/selected}}
</li>
{{/items}}
