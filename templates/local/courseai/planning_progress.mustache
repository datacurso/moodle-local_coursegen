{{!
    @template local_coursegen/local/courseai/planning_progress

    Progress area of the planning view: the progress card (state icon, step,
    title, percentage bar and the collapsible details panel), the legacy
    loader element toggled by the stream code, the in-place skeleton shown
    while the first instruction streams, and the streaming content containers
    (sections, detailed plan and Markdown views).

    All of these start hidden (or sized) with an inline display/width style
    because the JavaScript sets element.style on them (migrated in a later
    step). The skeleton is shown when the page resumes a session.

    Classes required for JS:
    * hidden - toggled on the typing cursor

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * isresuming bool - True when the page resumes an existing session

    Example context (json):
    {
        "isresuming": false
    }
}}
<div class="pc-card" id="planningProgressCard" style="display:none">
  <div class="pc-card-main">
    <span class="pc-icon-wrap" id="pcIconWrap" aria-hidden="true">
      <svg id="planningSpinner" class="pc-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
        <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
      </svg>
      <svg id="planningCheckIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" style="display:none">
        <polyline points="20 6 9 17 4 12"/>
      </svg>
    </span>
    <div class="pc-info">
      <span class="pc-step" id="pcStep">{{#str}}courseai_state_planning, local_coursegen{{/str}}</span>
      <h3 class="pc-title" id="pcTitle">{{#str}}courseai_state_structuring, local_coursegen{{/str}}</h3>
      <p class="pc-subtitle" id="pcSubtitle"></p>
    </div>
  </div>

  <div class="pc-progress-wrap">
    <div class="pc-progress-row">
      <span class="pc-progress-label">{{#str}}courseai_progress_label, local_coursegen{{/str}}</span>
      <span class="pc-progress-pct" id="pcPct">0{{#str}}courseai_progress_percent, local_coursegen{{/str}}</span>
    </div>
    <div class="pc-bar-track">
      <div class="pc-bar-fill" id="pcBarFill" style="width:0%"></div>
    </div>
  </div>

  <div class="pc-toggle-row" id="pcToggleRow" style="display:none">
    <button class="pc-toggle-btn" id="pcToggleBtn" type="button" aria-expanded="false">
      <svg class="pc-chevron" id="pcChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
      {{#str}}courseai_toggle_details, local_coursegen{{/str}}
    </button>
  </div>

  <div class="pc-details-panel" id="pcDetailsPanel" style="display:none"></div>
</div>

{{! Legacy loader element kept for compatibility (toggled by the stream code);
    the visible loader is the in-place skeleton below. }}
<div class="planning-loading" id="planningLoading" style="display:none"></div>

{{! Initial-streaming loader: an in-place skeleton that previews the detailed-plan
    card shape. Shown while the first instruction streams, hidden once the first
    section arrives. }}
<div class="cg-center-skeleton" id="cgCenterSkeleton" style="display:{{#isresuming}}block{{/isresuming}}{{^isresuming}}none{{/isresuming}}">{{> local_coursegen/courseai_skeleton_cards }}</div>

{{! Streaming content containers (hidden initially, shown as content arrives) }}
<div class="planning-stream-content" id="planningStreamContent" style="display:none">
  <div id="planSectionsView" style="display:none">
    <div id="planSectionsList"></div>
  </div>
  <div id="planDetailedView" style="display:none">
    <div id="planDetailedList"></div>
  </div>
  <div id="planMarkdownView" style="display:none">
    <div class="plan-markdown" id="planMarkdown"></div>
    <span class="typing-cursor hidden" id="typingCursor"></span>
  </div>
</div>
