{{!
    @template local_coursegen/local/courseai/composer_toolbar

    The "+" options toolbar of a course AI composer: the options menu (syllabus
    upload, guidelines, language, images and subsections toggles), the
    searchable language and guidelines popovers, and the hidden language select
    that is the source of truth for the selected language. Rendered twice on
    the page (main and compact composer) from this single source; the element
    ids differ per instance because the JavaScript addresses each instance by
    id (compact=false: btnPlusMenu, plusMenuPanel, btnSyllabus, btnDirectrices,
    guidelineBadge, pmLangItem, pmLangValue, imgToggleTrack, btnWithImages,
    subToggleTrack, btnWithSubsections, langPopover, langPopoverClose,
    langSearch, langList, guidelinesPopover, guidelinesPopoverClose,
    guidelineSearch, syllabusFilemanager, langSelect; compact=true:
    btnCompactPlusMenu, compactPlusMenuPanel, btnCompactSyllabus,
    btnCompactDirectrices, compactGuidelineBadge, pmCompactLangItem,
    pmCompactLangValue, compactImgToggleTrack, btnCompactWithImages,
    compactSubToggleTrack, btnCompactWithSubsections, langPopoverCompact,
    langPopoverCompactClose, langSearchCompact, langListCompact,
    guidelinesPopoverCompact, guidelinesPopoverCompactClose,
    guidelineSearchCompact, compactLangSelect).

    Classes required for JS:
    * tbar-toggle-wrap - wrapper of each toggle, resolved from the hidden checkbox
    * plus-menu-panel--up, popover-panel--down - panel direction per instance

    Data attributes required for JS:
    * data-region="guideline-list" (main) / "guideline-list-compact" (compact)
      on the wrapper the guideline list template is re-rendered into

    Context variables required for this template:
    * compact bool - True to render the compact (planning chat) instance
    * subsectionsenabled bool - Render the "with subsections" toggle
    * guidelinelist object - Context of the guideline list partial
      (local_coursegen/local/courseai/guideline_list or guideline_list_compact)

    Example context (json):
    {
        "compact": false,
        "subsectionsenabled": true,
        "guidelinelist": {
            "listlabel": "Guidelines list",
            "emptytext": "No results",
            "hasitems": false,
            "items": []
        }
    }
}}
<div class="plus-menu-wrap popover-wrap">
  <button class="plus-menu-btn" id="{{^compact}}btnPlusMenu{{/compact}}{{#compact}}btnCompactPlusMenu{{/compact}}" type="button"
          title="{{#str}}courseai_options_menu, local_coursegen{{/str}}"
          aria-label="{{#str}}courseai_options_menu, local_coursegen{{/str}}"
          aria-haspopup="true" aria-expanded="false">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
      <path d="M12 5v14M5 12h14"/>
    </svg>
  </button>

  <div class="plus-menu-panel{{#compact}} plus-menu-panel--up{{/compact}}" id="{{^compact}}plusMenuPanel{{/compact}}{{#compact}}compactPlusMenuPanel{{/compact}}" role="menu" aria-label="{{#str}}courseai_options_menu, local_coursegen{{/str}}">

    {{! Syllabus upload }}
    <button class="plus-menu-item" id="{{^compact}}btnSyllabus{{/compact}}{{#compact}}btnCompactSyllabus{{/compact}}" title="{{#str}}courseai_btn_syllabus_title, local_coursegen{{/str}}" type="button" role="menuitem">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
      </svg>
      <span class="plus-menu-item__label">{{#str}}courseai_btn_syllabus, local_coursegen{{/str}}</span>
    </button>

    {{! Guidelines (opens the guidelines popover) }}
    <button class="plus-menu-item" id="{{^compact}}btnDirectrices{{/compact}}{{#compact}}btnCompactDirectrices{{/compact}}" title="{{#str}}courseai_btn_guidelines_title, local_coursegen{{/str}}" type="button" role="menuitem" aria-haspopup="dialog" aria-expanded="false" aria-controls="{{^compact}}guidelinesPopover{{/compact}}{{#compact}}guidelinesPopoverCompact{{/compact}}">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10"/>
      </svg>
      <span class="plus-menu-item__label">{{#str}}courseai_btn_guidelines, local_coursegen{{/str}}</span>
      <span class="guideline-badge hidden" id="{{^compact}}guidelineBadge{{/compact}}{{#compact}}compactGuidelineBadge{{/compact}}"></span>
    </button>

    {{! Language (opens the searchable language popover) }}
    <button class="plus-menu-item" id="{{^compact}}pmLangItem{{/compact}}{{#compact}}pmCompactLangItem{{/compact}}" type="button" role="menuitem"
            aria-haspopup="dialog" aria-controls="{{^compact}}langPopover{{/compact}}{{#compact}}langPopoverCompact{{/compact}}"
            title="{{#str}}courseai_lang_title, local_coursegen{{/str}}">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
      </svg>
      <span class="plus-menu-item__label">{{#str}}courseai_lang_menu_label, local_coursegen{{/str}}</span>
      <span class="plus-menu-item__value" id="{{^compact}}pmLangValue{{/compact}}{{#compact}}pmCompactLangValue{{/compact}}"></span>
      <svg class="plus-menu-item__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="9 18 15 12 9 6"/>
      </svg>
    </button>

    {{! With images toggle switch }}
    <div class="tbar-toggle-wrap plus-menu-item plus-menu-item--toggle" title="{{#str}}courseai_images_title, local_coursegen{{/str}}" role="menuitemcheckbox" aria-checked="false" tabindex="0">
      <svg class="plus-menu-item__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
        <polyline points="21 15 16 10 5 21"/>
      </svg>
      <span class="plus-menu-item__label tbar-toggle-label">{{#str}}courseai_images_label, local_coursegen{{/str}}</span>
      <div class="toggle-track" id="{{^compact}}imgToggleTrack{{/compact}}{{#compact}}compactImgToggleTrack{{/compact}}">
        <div class="toggle-thumb"></div>
      </div>
      <input type="checkbox" id="{{^compact}}btnWithImages{{/compact}}{{#compact}}btnCompactWithImages{{/compact}}" class="hidden" aria-label="{{#str}}courseai_images_arialabel, local_coursegen{{/str}}">
    </div>

    {{#subsectionsenabled}}
    {{! With subsections toggle switch }}
    <div class="tbar-toggle-wrap plus-menu-item plus-menu-item--toggle" title="{{#str}}courseai_subsections_title, local_coursegen{{/str}}" role="menuitemcheckbox" aria-checked="false" tabindex="0">
      <svg class="plus-menu-item__icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
        <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
        <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
      </svg>
      <span class="plus-menu-item__label tbar-toggle-label">{{#str}}courseai_subsections_label, local_coursegen{{/str}}</span>
      <div class="toggle-track" id="{{^compact}}subToggleTrack{{/compact}}{{#compact}}compactSubToggleTrack{{/compact}}">
        <div class="toggle-thumb"></div>
      </div>
      <input type="checkbox" id="{{^compact}}btnWithSubsections{{/compact}}{{#compact}}btnCompactWithSubsections{{/compact}}" class="hidden" aria-label="{{#str}}courseai_subsections_arialabel, local_coursegen{{/str}}">
    </div>
    {{/subsectionsenabled}}

  </div>

  {{! Language popover: searchable list, same pattern as the guidelines popover }}
  <div class="popover-panel{{^compact}} popover-panel--down{{/compact}}" id="{{^compact}}langPopover{{/compact}}{{#compact}}langPopoverCompact{{/compact}}" role="dialog" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}">
    <button class="pop-close-btn" id="{{^compact}}langPopoverClose{{/compact}}{{#compact}}langPopoverCompactClose{{/compact}}" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <div class="pop-search-row">
      <div class="pop-search-inner">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input type="text" id="{{^compact}}langSearch{{/compact}}{{#compact}}langSearchCompact{{/compact}}" placeholder="{{#str}}courseai_lang_search_placeholder, local_coursegen{{/str}}" autocomplete="off">
      </div>
    </div>
    <ul class="pop-list" id="{{^compact}}langList{{/compact}}{{#compact}}langListCompact{{/compact}}" role="listbox" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}"></ul>
  </div>

  {{! Guidelines popover: anchored to the "+" area so it opens next to the menu }}
  <div class="popover-panel{{^compact}} popover-panel--down{{/compact}}" id="{{^compact}}guidelinesPopover{{/compact}}{{#compact}}guidelinesPopoverCompact{{/compact}}" role="dialog" aria-label="{{#str}}courseai_guidelines_dialog_label, local_coursegen{{/str}}">
    <button class="pop-close-btn" id="{{^compact}}guidelinesPopoverClose{{/compact}}{{#compact}}guidelinesPopoverCompactClose{{/compact}}" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
    <div class="pop-search-row">
      <div class="pop-search-inner">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
        <input type="text" id="{{^compact}}guidelineSearch{{/compact}}{{#compact}}guidelineSearchCompact{{/compact}}" placeholder="{{#str}}courseai_guidelines_search_placeholder, local_coursegen{{/str}}" autocomplete="off">
      </div>
      <p class="pop-note">{{#str}}courseai_guidelines_note_one, local_coursegen{{/str}}</p>
    </div>
    {{^compact}}
    <div class="pop-list-wrap" data-region="guideline-list">
      {{#guidelinelist}}{{> local_coursegen/local/courseai/guideline_list }}{{/guidelinelist}}
    </div>
    {{/compact}}
    {{#compact}}
    <div class="pop-list-wrap" data-region="guideline-list-compact">
      {{#guidelinelist}}{{> local_coursegen/local/courseai/guideline_list_compact }}{{/guidelinelist}}
    </div>
    {{/compact}}
  </div>
</div>

{{^compact}}
{{! Hidden file manager container for the Moodle file picker (main composer only) }}
<div class="hidden" id="syllabusFilemanager"></div>
{{/compact}}

{{! Hidden language select: the single source of truth for the selected language }}
<select class="tbar-select hidden" id="{{^compact}}langSelect{{/compact}}{{#compact}}compactLangSelect{{/compact}}" title="{{#str}}courseai_lang_title, local_coursegen{{/str}}" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}">
  <option value="es">🌐 ES</option>
  <option value="en">🌐 EN</option>
</select>
