{{!
    @template local_coursegen/preview_initial_svg

    A section's fallback picture: its own initial letter on a plain
    background, the way a course format draws a section with no picture of
    its own.

    Context variables required for this template:
    * initial - string, one letter.
}}
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 67"><rect width="100" height="67" fill="#8ca0ad"/><text x="50" y="42" font-size="28" fill="#ffffff" text-anchor="middle">{{initial}}</text></svg>
