{{!
    @template local_coursegen/presentation_editor_block

    One element of a slide: a field where the person tells the AI what to write, or writes what stays fixed.

    Example context (json):
    {"id": "b1", "label": "Title", "isAi": true, "isFixed": false, "isHtml": false, "canHtml": false, "canFix": true,
     "isTitle": true, "instr": "", "placeholder": "Tell the AI what the title should say", "busy": false, "hasresult": false, "showinstr": true, "change": ""}
}}
<div class="pe-block {{#isText}}pe-block-text{{/isText}}{{#isImage}}pe-block-image{{/isImage}}" data-block-id="{{id}}" data-drag-block="{{id}}">
    {{#busy}}{{> local_coursegen/presentation_editor_busy}}{{/busy}}
    <div class="pe-bhead">
        <label class="pe-label" for="pe-f-{{id}}">{{label}} <span class="pe-tag {{#isAi}}is-ai{{/isAi}}">{{#isAi}}{{#str}} pe_tag_ai, local_coursegen {{/str}}{{/isAi}}{{^isAi}}{{#str}} pe_tag_fixed, local_coursegen {{/str}}{{/isAi}}</span></label>
        <div class="dropdown pe-menu">
                <button type="button" class="btn btn-icon dropdown-toggle no-caret pe-menu-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                        title="{{#str}} pe_options, local_coursegen {{/str}}" aria-label="{{#str}} pe_options, local_coursegen {{/str}}"><i class="fa fa-ellipsis-v" aria-hidden="true"></i></button>
                <div class="dropdown-menu dropdown-menu-right">
                {{#canFix}}
                {{^isAi}}<button type="button" class="dropdown-item" data-action="local_coursegen/pe/mode" data-block="{{id}}" data-mode="ai">{{#str}} pe_menu_ai, local_coursegen {{/str}}</button>{{/isAi}}
                {{^isFixed}}<button type="button" class="dropdown-item" data-action="local_coursegen/pe/mode" data-block="{{id}}" data-mode="fixed">{{#str}} pe_menu_fixed, local_coursegen {{/str}}</button>{{/isFixed}}
                {{#canHtml}}{{^isHtml}}<button type="button" class="dropdown-item" data-action="local_coursegen/pe/mode" data-block="{{id}}" data-mode="html">{{#str}} pe_menu_html, local_coursegen {{/str}}</button>{{/isHtml}}{{/canHtml}}
                {{/canFix}}
                <button type="button" class="dropdown-item" data-action="local_coursegen/pe/copyopen" data-block="{{id}}">{{#str}} pe_copy, local_coursegen {{/str}}</button>
                <button type="button" class="dropdown-item text-danger" data-action="local_coursegen/pe/bdel" data-block="{{id}}">{{#str}} cpb_remove, local_coursegen {{/str}}</button>
            </div>
            </div>
    </div>

    {{#copyopen}}
    <div class="pe-copy">
        <label><input type="checkbox" data-copyall> {{#str}} pe_copy_all, local_coursegen {{/str}}</label>
        {{#copytargets}}<label><input type="checkbox" data-copy="{{index}}"> {{number}}</label>{{/copytargets}}
        <button type="button" class="pe-btn pe-btn-small" data-action="local_coursegen/pe/copydo" data-block="{{id}}">{{#str}} pe_copy_do, local_coursegen {{/str}}</button>
    </div>
    {{/copyopen}}

    {{#isTitle}}
    {{#showinstr}}<input id="pe-f-{{id}}" type="text" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} data-block="{{id}}" data-f="instr" value="{{instr}}" placeholder="{{placeholder}}">{{/showinstr}}
    {{^isAi}}<input id="pe-f-{{id}}" type="text" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} data-block="{{id}}" data-f="value" value="{{value}}" placeholder="{{#str}} pe_fixed_title, local_coursegen {{/str}}">{{/isAi}}
    {{/isTitle}}

    {{#isText}}
    {{#showinstr}}<textarea id="pe-f-{{id}}" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} rows="2" data-block="{{id}}" data-f="instr" placeholder="{{placeholder}}">{{instr}}</textarea>{{/showinstr}}
    {{#isFixed}}<textarea id="pe-f-{{id}}" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} rows="3" data-block="{{id}}" data-f="fixedtext" placeholder="{{#str}} pe_fixed_text, local_coursegen {{/str}}">{{fixedtext}}</textarea>{{/isFixed}}
    {{#isHtml}}
    <textarea id="pe-f-{{id}}" class="form-control pe-input pe-code {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} rows="5" data-block="{{id}}" data-f="html" placeholder="{{#str}} pe_html_placeholder, local_coursegen {{/str}}">{{html}}</textarea>
    <p class="pe-help">{{#str}} pe_html_help, local_coursegen {{/str}} {{#str}} pe_html_markers, local_coursegen {{/str}} <strong data-markers="{{id}}">{{markers}}</strong></p>
    {{/isHtml}}
    {{/isText}}

    {{#isImage}}
    {{#uploaded}}
    {{#previewurl}}<a class="pe-preview" href="{{previewurl}}" target="_blank" rel="noopener"><img src="{{previewurl}}" alt="{{name}}"></a>{{/previewurl}}
    <div class="pe-uploaded"><i class="fa fa-image" aria-hidden="true"></i><span class="pe-truncate">{{name}}</span>
        <button type="button" class="pe-link" data-action="local_coursegen/pe/removeimage" data-block="{{id}}">{{#str}} pe_image_remove, local_coursegen {{/str}}</button></div>
    <p class="pe-help">{{#str}} pe_image_own_help, local_coursegen {{/str}}</p>
    {{/uploaded}}
    {{^uploaded}}
    {{#showinstr}}<textarea id="pe-f-{{id}}" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} rows="2" data-block="{{id}}" data-f="instr" placeholder="{{placeholder}}">{{instr}}</textarea>{{/showinstr}}
    <button type="button" class="pe-link {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} data-action="local_coursegen/pe/uploadimage" data-block="{{id}}"><i class="fa fa-upload" aria-hidden="true"></i> {{#str}} pe_image_upload, local_coursegen {{/str}}</button>
    {{/uploaded}}
    {{/isImage}}

    {{#isVideo}}
    <input id="pe-f-{{id}}" type="url" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} data-block="{{id}}" data-f="url" value="{{url}}" placeholder="https://www.youtube.com/watch?v=">
    <p class="pe-help">{{#str}} pe_video_help, local_coursegen {{/str}}</p>
    {{/isVideo}}

    {{#isQuestion}}
    <div class="pe-kinds" role="group" aria-label="{{label}}">
        {{#kinds}}<button type="button" data-action="local_coursegen/pe/qkind" data-block="{{id}}" data-kind="{{key}}" aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{label}}</button>{{/kinds}}
    </div>
    {{#showinstr}}<textarea id="pe-f-{{id}}" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} rows="2" data-block="{{id}}" data-f="instr" placeholder="{{placeholder}}">{{instr}}</textarea>{{/showinstr}}
    {{^isAi}}
    {{#hasquestion}}
    <input id="pe-f-{{id}}" type="text" class="form-control pe-input {{#error}}is-invalid{{/error}}" {{#error}}aria-invalid="true"{{/error}} data-block="{{id}}" data-f="qprompt" value="{{qprompt}}" placeholder="{{#str}} pe_q_prompt, local_coursegen {{/str}}">
    {{#qmulti}}{{#qoptions}}
    <label class="pe-option"><input type="radio" name="pe-correct-{{id}}" data-block="{{id}}" data-f="qcorrect" data-option="{{index}}" {{#correct}}checked{{/correct}} title="{{#str}} pe_correct, local_coursegen {{/str}}" aria-label="{{#str}} pe_correct, local_coursegen {{/str}}">
        <input type="text" class="form-control pe-input" data-block="{{id}}" data-f="qoption" data-option="{{index}}" value="{{text}}" aria-label="{{#str}} pe_option, local_coursegen {{/str}}"></label>
    {{/qoptions}}{{/qmulti}}
    {{#qtf}}<div class="pe-tf"><label><input type="radio" name="pe-tf-{{id}}" data-block="{{id}}" data-f="qtf" value="true" {{#qtrue}}checked{{/qtrue}}> {{#str}} pe_true, local_coursegen {{/str}}</label>
        <label><input type="radio" name="pe-tf-{{id}}" data-block="{{id}}" data-f="qtf" value="false" {{^qtrue}}checked{{/qtrue}}> {{#str}} pe_false, local_coursegen {{/str}}</label></div>{{/qtf}}
    {{#qfill}}<textarea class="form-control pe-input" rows="3" data-block="{{id}}" data-f="qtext" aria-label="{{#str}} pe_kind_fill_in_the_blanks, local_coursegen {{/str}}">{{qtext}}</textarea>
        <p class="pe-help">{{#str}} pe_fill_help, local_coursegen {{/str}}</p>{{/qfill}}
    {{/hasquestion}}
    {{/isAi}}
    {{/isQuestion}}

    {{#error}}<p class="pe-error" data-error-for="{{id}}">{{.}}</p>{{/error}}

    {{#hasresult}}
    <div class="pe-result">
        {{#isTitle}}<strong>{{resulttext}}</strong>{{/isTitle}}
        {{#isText}}<div class="pe-result-html">{{{resulthtml}}}</div>{{/isText}}
        {{#isImage}}<span class="pe-result-image"><i class="fa fa-image" aria-hidden="true"></i> {{prompt}}</span>{{/isImage}}
        {{#isQuestion}}<strong>{{qprompt}}</strong>
            {{#qmulti}}<ul>{{#qoptions}}<li class="{{#correct}}is-right{{/correct}}">{{text}}</li>{{/qoptions}}</ul>{{/qmulti}}
            {{#qtf}}<span>{{#qtrue}}{{#str}} pe_true, local_coursegen {{/str}}{{/qtrue}}{{^qtrue}}{{#str}} pe_false, local_coursegen {{/str}}{{/qtrue}}</span>{{/qtf}}
            {{#qfill}}<span>{{qtext}}</span>{{/qfill}}{{/isQuestion}}
    </div>
    <div class="pe-change">
        <input type="text" class="form-control pe-input" data-block="{{id}}" data-f="change" value="{{change}}"
               aria-label="{{#str}} pe_change_ph, local_coursegen {{/str}}" placeholder="{{#str}} pe_change_ph, local_coursegen {{/str}}">
        <button type="button" class="pe-btn pe-btn-small" data-action="local_coursegen/pe/regen" data-block="{{id}}">{{#str}} pe_change_apply, local_coursegen {{/str}}</button>
    </div>
    {{/hasresult}}
</div>
