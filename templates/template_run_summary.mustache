{{!
    @template local_coursegen/template_run_summary

    The first message of the thread of a course made from a template: what it was generated with.

    Context variables required for this template:
    * template - Template name
    * language - Course language, as the language selector names it
    * hassyllabusrow - Whether the syllabus is known (sessions started before it was kept do not know it)
    * syllabus - Attached syllabus file name, empty for none
    * instruction - General instruction typed by the professor, empty for none

    Example context (json):
    {
        "template": "Plantilla H5P",
        "language": "Español - Internacional (ES)",
        "hassyllabusrow": true,
        "syllabus": "silabo.pdf",
        "instruction": "Curso de seguridad industrial para operarios."
    }
}}
<div class="cg-log-entry cg-log-entry--neutral cg-log-entry--turn-system cg-run-summary" role="status">
    <span class="cg-log-body">
        <span class="cg-log-actor" aria-hidden="true">⚙️</span>
        <span class="cg-run-summary-body">
            <span class="cg-run-summary-title">{{#str}} courseai_template_summary_title, local_coursegen {{/str}}</span>
            <dl class="cg-run-summary-list">
                <dt>{{#str}} courseai_template_summary_template, local_coursegen {{/str}}</dt>
                <dd>{{template}}</dd>
                <dt>{{#str}} courseai_template_summary_language, local_coursegen {{/str}}</dt>
                <dd>{{language}}</dd>
                {{#hassyllabusrow}}
                <dt>{{#str}} courseai_template_summary_syllabus, local_coursegen {{/str}}</dt>
                <dd>{{#syllabus}}{{.}}{{/syllabus}}{{^syllabus}}<span class="cg-run-summary-none">{{#str}} courseai_template_summary_nosyllabus, local_coursegen {{/str}}</span>{{/syllabus}}</dd>
                {{/hassyllabusrow}}
                <dt>{{#str}} courseai_template_summary_instruction, local_coursegen {{/str}}</dt>
                <dd class="cg-run-summary-instruction">{{#instruction}}{{.}}{{/instruction}}{{^instruction}}<span class="cg-run-summary-none">{{#str}} courseai_template_summary_noinstruction, local_coursegen {{/str}}</span>{{/instruction}}</dd>
            </dl>
        </span>
    </span>
</div>
