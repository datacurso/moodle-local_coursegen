{{!
    @template local_coursegen/preview_browse_button

    A previewed SCORM package's browse button: a link to its launch page
    when one is found in the payload's files, disabled otherwise.

    Context variables required for this template:
    * label - string.

    Context variables optional for this template:
    * url - string.
}}
{{#url}}
<a class="btn btn-secondary me-1" target="_blank" rel="noopener" href="{{{url}}}">{{label}}</a>
{{/url}}
{{^url}}
<button type="button" class="btn btn-secondary me-1" disabled="disabled">{{label}}</button>
{{/url}}
