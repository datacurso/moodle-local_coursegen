{{!
    @template local_coursegen/preview_container

    One plain div, shared by every previewed module that used to build one
    with html_writer::div() or html_writer::tag('div', ...) just to wrap
    already-rendered content under an id and/or a class.

    Context variables optional for this template:
    * id - string.
    * classes - string.
    * style - string, inline style for the rare case a size or a colour is
              per-instance data rather than something a stylesheet can state.

    Context variables required for this template:
    * content - string, already-rendered HTML.
}}
<div{{#id}} id="{{id}}"{{/id}}{{#classes}} class="{{classes}}"{{/classes}}{{#style}} style="{{style}}"{{/style}}>{{{content}}}</div>
