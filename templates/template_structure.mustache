{{!
    @template local_coursegen/template_structure

    Professor-facing "guided form" view of a course template: sections and
    activities rendered with the same markup/classes core_courseformat uses
    (course-section / section-item / activity-item / activity-grid), so the
    theme's own Boost CSS provides card chrome, icon tints and grid layout.
    Locked sections/activities (kept as-is from the template) are visually
    dimmed and expose no destructive controls. JS (template_mode.js and its
    local/template submodules) only supplies data and wires behaviour via
    data-action attributes — this template owns 100% of the markup.

    Classes required for JS:
    * none — all JS hooks are data-action attributes.

    Data attributes required for JS:
    * data-action="local_coursegen/template/toggle-section" on the section chevron

    A section/activity has no id of its own here: every data-section-index and
    data-activity-index is a position in the in-memory model (state.js), not a
    database id, so a row loaded from the server and a click on it are addressed
    the same way.

    Context variables required for this template:
    * sections array - index int, name string, locked bool, collapsed bool, activitiescount int, activities array
        * activities[].name string, modname string (may be empty),
          purpose string, iconhtml string (raw, may be empty), locked bool,
          isinstance bool, aigenerated bool (shows the "AI will generate it"
          badge), generationuid string (optional; the id a live progress
          event and its own preview answer to), sectionindex int, index int,
          typelabel string (optional)

    Example context (json):
    {
        "sections": [
            {
                "index": 0, "name": "Introduction", "locked": false, "collapsed": false,
                "activitiescount": 2,
                "activities": [
                    {
                        "name": "Welcome page", "modname": "page", "purpose": "content",
                        "iconhtml": "<img class=\"icon activityicon\" src=\"#\" alt=\"\">",
                        "locked": true, "isinstance": false, "aigenerated": false,
                        "sectionindex": 0, "index": 0, "typelabel": "Page"
                    },
                    {
                        "name": "Weekly guide", "modname": "resource", "purpose": "content",
                        "iconhtml": "<img class=\"icon activityicon\" src=\"#\" alt=\"\">",
                        "locked": false, "isinstance": false, "aigenerated": true,
                        "sectionindex": 0, "index": 1, "typelabel": "File"
                    }
                ]
            }
        ]
    }
}}
<ul class="course-content course-section-list list-unstyled m-0" data-region="template-section-list">
{{#sections}}
  <li class="section course-section main clearfix{{#locked}} is-locked{{/locked}}" data-section-index="{{index}}">
    <div class="section-item">
      <div class="course-section-header d-flex align-items-center position-relative">
        <a role="button" href="#tplSectionCollapse{{index}}" aria-expanded="{{#collapsed}}false{{/collapsed}}{{^collapsed}}true{{/collapsed}}"
           aria-controls="tplSectionCollapse{{index}}"
           class="btn btn-icon me-3 icons-collapse-expand justify-content-center{{#collapsed}} collapsed{{/collapsed}}"
           data-action="local_coursegen/template/toggle-section" data-section-index="{{index}}">
          <span class="expanded-icon icon-no-margin p-2">{{#pix}} t/expandedchevron, core {{/pix}}</span>
          <span class="collapsed-icon icon-no-margin p-2">{{#pix}} t/collapsedchevron, core {{/pix}}</span>
        </a>
        <h3 class="h4 sectionname course-content-item d-flex align-self-stretch align-items-center mb-0">
          <span class="mr-2">{{name}}</span>
          {{#locked}}
          <span class="badge badge-light border cg-tpl-locked-badge">
            {{#pix}} t/locked, core {{/pix}} {{#str}}courseai_template_locked_badge, local_coursegen{{/str}}
          </span>
          {{/locked}}
        </h3>
        <div class="cg-item-actions cg-item-actions--section ms-auto d-flex align-items-center">
          <span class="cg-section-meta badge bg-light text-muted">
            {{activitiescount}} {{#str}}courseai_activities_count, local_coursegen{{/str}}
          </span>
        </div>
      </div>
      {{#locked}}
      <p class="cg-tpl-locked-note small text-muted px-3 mb-0 pt-1">
        {{#str}}courseai_template_locked_note, local_coursegen{{/str}}
      </p>
      {{/locked}}
      <div id="tplSectionCollapse{{index}}" class="content course-content-item-content collapse{{^collapsed}} show{{/collapsed}}">
        <ul class="section m-0 p-0 img-text d-block">
          {{#activities}}
          <li class="activity activity-wrapper {{modname}} modtype_{{modname}}{{#locked}} is-locked{{/locked}}"
              data-section-index="{{sectionindex}}" data-activity-index="{{index}}"
              {{#generationuid}}data-generation-uid="{{generationuid}}"{{/generationuid}}>
            <div class="activity-item focus-control" data-region="activity-card">
              <div class="activity-grid">
                <div class="activity-icon activityiconcontainer smaller {{purpose}} courseicon align-self-start me-2">
                  {{{iconhtml}}}
                </div>
                <div class="activity-name-area activity-instance d-flex flex-column me-2">
                  <div class="activitytitle modtype_{{modname}} position-relative align-self-start">
                    <div class="activityname"><span class="instancename">{{name}}</span>
                      {{#aigenerated}}
                      <span class="badge badge-light border cg-tpl-instance-badge"
                            title="{{#str}}courseai_template_instance_badge_tip, local_coursegen{{/str}}">
                        {{#str}}courseai_template_instance_badge, local_coursegen{{/str}}
                      </span>
                      {{/aigenerated}}
                    </div>
                  </div>
                  {{#typelabel}}
                  <p class="cg-activity-desc mb-0">{{typelabel}}</p>
                  {{/typelabel}}
                  {{#generationuid}}
                  {{! Notices of the generation about this activity, such as a video it could not find;
                      filled when the review opens, see template/generation_review.js. }}
                  <div data-region="local_coursegen/template/generation-notices" data-notice-uid="{{generationuid}}"></div>
                  {{/generationuid}}
                </div>
                <div class="activity-actions cg-item-actions align-self-start ms-sm-2">
                  {{#generationuid}}
                  {{! Opens what this activity is going to look like. Hidden
                      until a run exists, because there is nothing to preview
                      before one does; see template/preview.js. }}
                  <a href="#" class="dp-action-btn cg-preview-btn" hidden
                     data-action="local_coursegen/template/preview-activity"
                     data-generation-uid="{{generationuid}}"
                     aria-label="{{#str}}courseai_preview_activity, local_coursegen{{/str}}"
                     title="{{#str}}courseai_preview_activity, local_coursegen{{/str}}">
                    {{#pix}} i/preview, core {{/pix}}
                  </a>
                  {{! Asks for a change to this one activity once it is generated.
                      Hidden until the review is open, because there is nothing
                      to change before then; see template/generation_review.js. }}
                  <span class="dp-action-btn cg-adjust-btn" role="button" tabindex="0" hidden
                        data-action="local_coursegen/template/adjust-activity"
                        data-generation-uid="{{generationuid}}"
                        aria-label="{{#str}}courseai_template_adjust_activity, local_coursegen{{/str}}"
                        title="{{#str}}courseai_template_adjust_activity, local_coursegen{{/str}}">
                    {{#pix}} i/edit, core {{/pix}}
                  </span>
                  {{/generationuid}}
                </div>
              </div>
            </div>
          </li>
          {{/activities}}
        </ul>
      </div>
    </div>
  </li>
{{/sections}}
</ul>
