{{!
    @template local_coursegen/allowed_types_actions

    "Select all" / "Select none" convenience buttons for the allowed
    activity types field (see amd/src/local/template/step_limits.js), each
    with a plain native title attribute for its hover explanation — the
    same everyday browser tooltip Moodle uses for this kind of short hint
    elsewhere, no custom markup or CSS.

    Example context (json):
    {
        "selectalllabel": "Select all",
        "selectalltooltip": "Selects every AI-supported activity type.",
        "selectnonelabel": "Select none",
        "selectnonetooltip": "Clears every currently selected activity type."
    }
}}
<button type="button" class="btn btn-link p-0 mr-3" data-action="select-all-allowedtypes"
    title="{{selectalltooltip}}">{{selectalllabel}}</button>
<button type="button" class="btn btn-link p-0" data-action="select-none-allowedtypes"
    title="{{selectnonetooltip}}">{{selectnonelabel}}</button>
