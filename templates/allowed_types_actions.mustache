{{!
    @template local_coursegen/allowed_types_actions

    "Select all" / "Select none" convenience buttons for the allowed
    activity types field (see amd/src/local/template/step_limits.js), each
    with Moodle's own native hover-tooltip explanation — pure CSS
    (.hover-tooltip-container/.hover-tooltip, the same classes
    lib/templates/hover_tooltip.mustache uses), no JavaScript.

    Example context (json):
    {
        "selectalllabel": "Select all",
        "selectalltooltip": "Selects every AI-supported activity type.",
        "selectnonelabel": "Select none",
        "selectnonetooltip": "Clears every currently selected activity type."
    }
}}
<div class="hover-tooltip-container d-inline-block mr-3">
    <button type="button" class="btn btn-link p-0" data-action="select-all-allowedtypes">{{selectalllabel}}</button>
    <div class="hover-tooltip"><strong>{{selectalltooltip}}</strong></div>
</div>
<div class="hover-tooltip-container d-inline-block">
    <button type="button" class="btn btn-link p-0" data-action="select-none-allowedtypes">{{selectnonelabel}}</button>
    <div class="hover-tooltip"><strong>{{selectnonetooltip}}</strong></div>
</div>
