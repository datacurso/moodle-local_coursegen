{{!
    @template local_coursegen/start_modebar

    The bar above a path's workspace naming the starting point that was
    chosen: a way back to the chooser, the crumb, and a chip that says
    "Free creation" or "From a template". Both labels are rendered; the
    bar's data-start-path attribute, kept by start_path.js, decides which
    one shows. Once planning has started the way back is disabled. The
    column slot (.courseai-modebar-slot--column) hides the change link by
    CSS: the arrow already does it and the column has less room.

    Classes required for JS:
    * none.

    Data attributes required for JS:
    * data-start-modebar on the root; data-action="start-back" and
      data-action="start-change" on the controls.

    Context variables required for this template:
    * none.

    Example context (json):
    {}
}}
<div class="courseai-modebar" data-start-modebar>
  <button class="courseai-modebar-back" type="button" data-action="start-back"
          aria-label="{{#str}}courseai_start_back, local_coursegen{{/str}}"
          title="{{#str}}courseai_start_back, local_coursegen{{/str}}"
          data-title-unlocked="{{#str}}courseai_start_back, local_coursegen{{/str}}"
          data-title-locked="{{#str}}courseai_start_locked, local_coursegen{{/str}}">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 6l-6 6 6 6"/>
    </svg>
  </button>
  <span class="courseai-modebar-crumb">
    {{#str}}createwithai, local_coursegen{{/str}}
    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M9 6l6 6-6 6"/>
    </svg>
  </span>
  <span class="courseai-modebar-chip courseai-modebar-chip--free" data-start-chip="free">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m12 3-1.9 5.8a2 2 0 0 1-1.287 1.288L3 12l5.8 1.9a2 2 0 0 1 1.288 1.287L12 21l1.9-5.8a2 2 0 0 1 1.287-1.288L21 12l-5.8-1.9a2 2 0 0 1-1.288-1.287Z"/>
    </svg>
    {{#str}}courseai_mode_free, local_coursegen{{/str}}
  </span>
  <span class="courseai-modebar-chip courseai-modebar-chip--template" data-start-chip="template">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>
    </svg>
    {{#str}}courseai_start_template, local_coursegen{{/str}}
  </span>
  <button class="courseai-modebar-change" type="button" data-action="start-change">{{#str}}courseai_start_change, local_coursegen{{/str}}</button>
</div>
