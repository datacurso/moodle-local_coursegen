{{!
    @template local_coursegen/start_chooser

    The first screen of the course-creation page: how do you want to start?
    Two cards, one per starting point. Picking one opens that path's
    workspace; the top bar then names the path and leads back here
    (#courseaiPathBack). The page shows this screen while the workspace
    carries the `is-choosing` class (local/courseai/start_path.js).

    Classes required for JS:
    * none — cards are found by data-start-path.

    Data attributes required for JS:
    * data-start-path="free|template" on each card.

    Context variables required for this template:
    * none.

    Example context (json):
    {}
}}
<section class="courseai-start" id="courseaiChooser" aria-labelledby="courseaiStartTitle">
  <div class="courseai-start-inner">
    <h2 class="courseai-start-title" id="courseaiStartTitle">{{#str}}courseai_start_title, local_coursegen{{/str}}</h2>
    <p class="courseai-start-subtitle">{{#str}}courseai_start_subtitle, local_coursegen{{/str}}</p>
    <div class="courseai-start-cards">
      <button class="courseai-start-card courseai-start-card--free" type="button" data-start-path="free">
        <span class="courseai-start-badge">{{#str}}courseai_start_mostused, local_coursegen{{/str}}</span>
        <span class="courseai-start-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m12 3-1.9 5.8a2 2 0 0 1-1.287 1.288L3 12l5.8 1.9a2 2 0 0 1 1.288 1.287L12 21l1.9-5.8a2 2 0 0 1 1.287-1.288L21 12l-5.8-1.9a2 2 0 0 1-1.288-1.287Z"/>
          </svg>
        </span>
        <span class="courseai-start-card-title">{{#str}}courseai_mode_free, local_coursegen{{/str}}</span>
        <span class="courseai-start-card-desc">{{#str}}courseai_start_free_desc, local_coursegen{{/str}}</span>
        <span class="courseai-start-card-for">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 3"/>
          </svg>
          {{#str}}courseai_start_free_for, local_coursegen{{/str}}
        </span>
      </button>
      <button class="courseai-start-card courseai-start-card--template" type="button" data-start-path="template">
        <span class="courseai-start-icon" aria-hidden="true">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18M9 10v10"/>
          </svg>
        </span>
        <span class="courseai-start-card-title">{{#str}}courseai_start_template, local_coursegen{{/str}}</span>
        <span class="courseai-start-card-desc">{{#str}}courseai_start_template_desc, local_coursegen{{/str}}</span>
        <span class="courseai-start-card-for">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 3"/>
          </svg>
          {{#str}}courseai_start_template_for, local_coursegen{{/str}}
        </span>
      </button>
    </div>
    <p class="courseai-start-note">{{#str}}courseai_start_note, local_coursegen{{/str}}</p>
  </div>
</section>
