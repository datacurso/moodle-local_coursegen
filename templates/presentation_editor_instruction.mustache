{{!
    @template local_coursegen/presentation_editor_instruction

    The line to tell the AI what to write in a part of a slide, with the button to apply it to that part.

    Context variables required for this template:
    * zone string        - The part: title, body, image, question or slide.
    * value string       - What was typed.
    * placeholder string - The hint.
    * label string       - The name of the part.
    * working bool       - The AI is writing it.

    Example context (json):
    {"zone": "title", "value": "", "placeholder": "Tell the AI what to write", "label": "Title", "working": false}
}}
<div class="input-group input-group-sm mt-1">
    <div class="input-group-prepend"><span class="input-group-text"><i class="fa fa-star" aria-hidden="true"></i></span></div>
    <input type="text" class="form-control" data-instr="{{zone}}" value="{{value}}" placeholder="{{placeholder}}" aria-label="{{label}}: {{placeholder}}">
    <div class="input-group-append">
        <button type="button" class="btn btn-secondary" data-action="local_coursegen/pe/apply" data-zone="{{zone}}">
            {{#working}}<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>{{/working}}
            {{^working}}{{#str}} pe_instr_apply, local_coursegen {{/str}}{{/working}}
        </button>
    </div>
</div>
