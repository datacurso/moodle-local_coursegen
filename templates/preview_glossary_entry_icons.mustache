{{!
    @template local_coursegen/preview_glossary_entry_icons

    A previewed glossary entry's command icons, ported from
    mod/glossary/lib.php glossary_print_entry_icons().

    Context variables required for this template:
    * show - bool, whether there is anything at all to draw.
    * hidden - bool.
    * hiddentext - string.
    * exportedtext - string.

    Context variables optional for this template:
    * linkicon, disapproveicon, deleteicon, editicon - each either absent or
      {url, title, iconhtml}.
}}
{{#show}}
<span class="commands">
    {{#hidden}}<span class="glossary-hidden-note">{{hiddentext}}</span>{{/hidden}}
    {{#linkicon}}<a href="{{{url}}}" title="{{title}}" class="icon">{{{iconhtml}}}</a>{{/linkicon}}
    {{#disapproveicon}}<a href="{{{url}}}" title="{{title}}" class="icon">{{{iconhtml}}}</a>{{/disapproveicon}}
    {{#deleteicon}}<a href="{{{url}}}" title="{{title}}" class="icon">{{{iconhtml}}}</a>{{/deleteicon}}
    {{#editicon}}<a href="{{{url}}}" title="{{title}}" class="icon">{{{iconhtml}}}</a>{{/editicon}}
    {{#exportedtext}}<span class="small">{{exportedtext}}</span>{{/exportedtext}}
</span>
{{/show}}
