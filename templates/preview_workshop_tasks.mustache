{{!
    @template local_coursegen/preview_workshop_tasks

    One phase's list of tasks, ported from
    mod_workshop_renderer::helper_user_plan_tasks(). The caller checks the
    list is not empty before rendering this template, the way the ported
    code only wraps a <ul> around tasks that exist.

    Context variables required for this template:
    * tasks - array of {classes, accessibilitytext, link, title, details}.
}}
<ul class="tasks">
    {{#tasks}}
    <li class="{{classes}}">
        <div class="title">
            <span class="accesshide">{{accessibilitytext}} </span>
            {{#link}}<a href="{{{link}}}">{{title}}</a>{{/link}}
            {{^link}}{{title}}{{/link}}
        </div>
        <div class="details">{{{details}}}</div>
    </li>
    {{/tasks}}
</ul>
