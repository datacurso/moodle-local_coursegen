{{!
    @template local_coursegen/template_course_sections_row

    One row of the "Course sections" review table — a real activity or a
    virtual template instance — plus the hover-reveal insertion gap that
    follows it. Included once per entry of a section's "rows" array by
    template_course_sections.mustache (split out to keep that file under
    the project's 250-line cap); never rendered on its own.

    Context variables: see template_course_sections.mustache's own
    docblock for the full shape of one "rows" entry.
}}
{{#isreal}}
<tr class="{{#istemplate}}tpl-row-template{{/istemplate}}" data-for="cmitem" data-id="{{cmid}}" data-modname="{{modname}}" data-typelabel="{{typelabel}}">
    <td class="align-middle tpl-select-col">
        <input type="checkbox" data-region="activity-select" data-id="{{cmid}}"
               aria-label="{{name}}">
    </td>
    <td class="align-middle">
        <img src="{{iconurl}}" class="icon activityicon mr-2" alt="">{{!
        }}{{#viewurl}}<a href="{{viewurl}}" target="_blank" rel="noopener">{{name}}</a>{{/viewurl}}{{!
        }}{{^viewurl}}<span>{{name}}</span>{{/viewurl}}{{!
        }}<button type="button"
                class="tpl-badge tpl-badge-template tpl-template-tag ml-2{{^istemplate}} d-none{{/istemplate}}"
                data-region="template-tag" data-id="{{cmid}}" data-name="{{name}}"
                data-tag-course="{{#str}} template_activity_template_tag, local_coursegen, {{scopelabelcourse}} {{/str}}"
                data-tag-section="{{#str}} template_activity_template_tag, local_coursegen, {{scopelabelsection}} {{/str}}">
            {{#str}} template_activity_template_tag, local_coursegen, {{scopelabel}} {{/str}}
        </button>
    </td>
    <td class="align-middle text-muted">{{typelabel}}</td>
    <td class="align-middle text-right">
        <select class="custom-select custom-select-sm tpl-activity-action"
                data-region="activity-action" data-id="{{cmid}}"
                aria-label="{{#str}} actions, core {{/str}}">
            {{#actions}}
            <option value="{{value}}" title="{{tip}}"{{#active}} selected{{/active}}>{{label}}</option>
            {{/actions}}
        </select>
    </td>
</tr>
{{/isreal}}
{{#isinstance}}
<tr class="tpl-row-instance" data-for="instancerow" data-instance-id="{{instanceid}}">
    <td class="align-middle tpl-select-col"></td>
    <td class="align-middle">
        <span class="icon activityicon tpl-instance-icon mr-2"></span>
        <input type="text" class="tpl-instance-name-input" value="{{name}}"
               data-region="instance-name" data-id="{{instanceid}}"
               aria-label="{{#str}} template_instance_name, local_coursegen {{/str}}">
        <span class="tpl-badge tpl-badge-instance ml-2">{{badge}}</span>
    </td>
    <td class="align-middle text-muted">{{typelabel}}</td>
    <td class="align-middle text-right">
        <div class="tpl-instance-actions">
            <button type="button" class="tpl-instance-icon-btn" data-region="instance-prompt-toggle" data-id="{{instanceid}}"
                    title="{{#str}} template_instance_prompt_edit, local_coursegen {{/str}}">&#9998;</button>
            <button type="button" class="tpl-instance-icon-btn tpl-instance-icon-danger" data-region="instance-remove" data-id="{{instanceid}}"
                    title="{{#str}} template_instance_remove, local_coursegen {{/str}}">&times;</button>
        </div>
    </td>
</tr>
<tr class="tpl-instance-prompt-row d-none" data-for="instanceprompt" data-instance-id="{{instanceid}}">
    <td colspan="4">
        <div class="tpl-prompt-field">
            <textarea data-region="instance-prompt" data-id="{{instanceid}}" rows="2"
                      placeholder="{{#str}} template_instance_prompt_placeholder, local_coursegen {{/str}}">{{prompt}}</textarea>
        </div>
    </td>
</tr>
{{/isinstance}}
<tr class="tpl-row-gap" data-region="row-gap">
    <td colspan="4">
        <div class="tpl-row-gap-line">
            <div class="dropdown tpl-instance-dropdown">
                <button type="button" class="tpl-row-gap-plus" data-instance-menu-trigger
                        aria-haspopup="true" aria-expanded="false"
                        title="{{#str}} template_add_instance, local_coursegen {{/str}}">+</button>
                <div class="dropdown-menu tpl-instance-menu" role="menu"></div>
            </div>
        </div>
    </td>
</tr>
