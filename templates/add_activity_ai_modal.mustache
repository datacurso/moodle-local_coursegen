{{!
    @template local_coursegen/add_activity_ai_modal

    Activity AI Modal Template

    Template for the activity AI generation modal interface.
    Contains chat interface for AI-powered activity creation with integrated streaming.

    Example context (json):
    {
        "courseid": 123,
        "coursename": "Mathematics 101",
        "sectionnum": 1
    }
}}
<div class="local_coursegen_ai_chat pb-4 container" aria-label="{{#str}} addactivityai_arialabel, local_coursegen {{/str}}" data-region="local_coursegen/activity/root">
    <!-- Welcome Message -->
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="activity-welcome-message p-3 mb-3 bg-light rounded">
                <p class="mb-0">{{#str}} addactivityai_welcome, local_coursegen {{/str}}</p>
            </div>
        </div>
    </div>

    <!-- User Messages Section -->
    <div class="row justify-content-center">
        <div class="col-lg-10" data-region="local_coursegen/activity/user_messages" style="display: none;">
            <!-- User messages will be added here -->
        </div>
    </div>

    <!-- Streaming Phase Section (reuse course streaming structure inside modal) -->
    <div class="row justify-content-center">
        <div class="col-lg-10" data-region="local_coursegen/activity/streaming" style="display: none;">
            <div data-region="local_coursegen/aicoursecreation/output"
                 class="mb-4 text-dark"
                 style="font-size: 1.05rem; line-height: 1.7;">
            </div>
        </div>
    </div>
</div>


