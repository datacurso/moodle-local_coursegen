{{!
    @template local_coursegen/template_wizard

    Template configuration — one screen, no step navigation. Pick a base
    course, then review the overall limits, the default behavior per kind
    of component, and the course structure — all on this same page — and
    Save. All initial state rendered server-side, no JS flash.

    Example context (json):
    {
        "sesskey": "abc",
        "haspreview": false,
        "hassectionsconfig": false
    }
}}
<div id="local-coursegen-template-wizard" data-region="template-wizard">

    {{! Course selection }}
    <div data-region="step-panel" data-step="1">
        <h4>{{#str}}template_select_course, local_coursegen{{/str}}</h4>
        <p class="text-muted">{{#str}}template_select_course_desc, local_coursegen{{/str}}</p>

        <div class="alert alert-success mb-3 {{^haspreview}}d-none{{/haspreview}}" data-region="selected-banner">
            <div class="d-flex align-items-center">
                {{#pix}}i/valid, core{{/pix}}
                <span class="ml-2">
                    {{#str}}template_selected_course, local_coursegen{{/str}}
                    <strong data-region="selected-name">{{initialcoursename}}</strong>
                    (<span data-region="selected-short">{{initialcourseshortname}}</span>)
                </span>
                <a href="{{wwwroot}}/course/view.php?id={{initialcourseid}}" target="_blank"
                   class="btn btn-sm btn-link" data-region="selected-link">
                    {{#pix}}i/externallink, core{{/pix}}
                    {{#str}}template_view_course, local_coursegen{{/str}}
                </a>
                <button class="btn btn-sm btn-link ml-auto" data-action="deselect">
                    {{#str}}template_change_course, local_coursegen{{/str}}
                </button>
            </div>
        </div>

        <div data-region="course-browser" class="{{#haspreview}}d-none{{/haspreview}}">
            <div class="input-group mb-3" style="max-width:350px">
                <input type="text" class="form-control" data-action="global-search"
                       placeholder="{{#str}}template_search_placeholder_full, local_coursegen{{/str}}">
                <div class="input-group-append">
                    <button class="btn btn-primary" data-action="search-btn" type="button">
                        {{#pix}}i/search, core{{/pix}}
                    </button>
                </div>
            </div>

            <div class="row">
                <div class="col-md-5 col-lg-4">
                    <div class="card">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <strong>{{#str}}categories{{/str}}</strong>
                            <button class="btn btn-sm btn-link p-0" data-action="toggle-all"
                                    title="Expand / Collapse all">
                                {{#pix}}i/switch, core{{/pix}}
                            </button>
                        </div>
                        <div class="card-body p-0" style="max-height:450px;overflow-y:auto"
                             data-region="category-tree">
                            <div class="list-group list-group-flush">
                                {{#flatcats}}
                                <div class="list-group-item list-group-item-action align-items-start py-2 {{hiddenclass}}"
                                     data-catid="{{id}}" data-depth="{{depth}}"
                                     data-haschildren="{{#haschildren}}1{{/haschildren}}{{^haschildren}}0{{/haschildren}}"
                                     style="padding-left:calc(0.75rem + {{depth}} * 0.75rem);cursor:pointer;{{^hiddenclass}}display:flex{{/hiddenclass}}">
                                    <span class="mr-1 mt-1 small flex-shrink-0" style="width:16px">
                                        {{#haschildren}}<i class="fa fa-chevron-right fa-fw"></i>{{/haschildren}}
                                    </span>
                                    <span class="flex-grow-1" style="word-break:break-word">{{name}}</span>
                                    <span class="badge badge-pill badge-secondary ml-1">{{coursecount}}</span>
                                </div>
                                {{/flatcats}}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-7 col-lg-8">
                    <div class="card">
                        <div class="card-header py-2 d-flex justify-content-between align-items-center">
                            <strong data-region="course-panel-title">{{#str}}courses{{/str}}</strong>
                            <span class="text-muted small" data-region="course-count"></span>
                        </div>
                        <div class="card-body p-0" data-region="course-list"
                             style="min-height:450px;max-height:450px;overflow-y:auto">
                            <div class="text-center text-muted py-4">
                                {{#str}}template_select_category_hint, local_coursegen{{/str}}
                            </div>
                        </div>
                        <div class="card-footer py-2 d-none" data-region="course-pagination"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{! Configuration — only meaningful once a course is selected }}
    <div data-region="config" class="{{^haspreview}}d-none{{/haspreview}}">
        <hr class="my-4">

        {{! Default behavior per kind of component }}
        <h4>{{#str}}template_kind_defaults_title, local_coursegen{{/str}}</h4>
        <p class="text-muted">{{#str}}template_kind_defaults_desc, local_coursegen{{/str}}</p>
        <div data-region="kind-defaults" class="mb-4"></div>

        {{! Overall limits — folded into this same screen, not a separate step }}
        <h4>{{#str}}template_limits_title, local_coursegen{{/str}}</h4>
        <p class="text-muted mb-3">{{#str}}template_limits_desc, local_coursegen{{/str}}</p>
        <div data-region="limits">
            <div class="form-group row">
                <label class="col-md-3 col-form-label font-weight-bold">
                    {{#str}}template_max_sections, local_coursegen{{/str}}
                </label>
                <div class="col-md-9">
                    <div class="d-flex align-items-center mb-1">
                        <input type="number" class="form-control" style="width:80px"
                               data-field="max-sections" value="0" min="1" max="50">
                        <div class="custom-control custom-checkbox ml-3">
                            <input type="checkbox" class="custom-control-input"
                                   id="tpl-no-limit" data-field="no-limit">
                            <label class="custom-control-label" for="tpl-no-limit">
                                {{#str}}template_no_limit, local_coursegen{{/str}}
                            </label>
                        </div>
                    </div>
                    <small class="form-text text-muted" data-region="sections-hint"></small>
                </div>
            </div>
            <hr>
            <div class="form-group row">
                <label class="col-md-3 col-form-label font-weight-bold">
                    {{#str}}template_allowed_types, local_coursegen{{/str}}
                </label>
                <div class="col-md-9">
                    <p class="text-muted small mb-2">
                        {{#str}}template_allowed_types_desc, local_coursegen{{/str}}
                    </p>
                    <div class="border rounded p-3" style="max-height:250px;overflow-y:auto">
                        <div class="row">
                            {{#modtypes}}
                            <div class="col-6 col-md-4 mb-1">
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" class="custom-control-input"
                                           id="tpl-t-{{id}}" data-action="toggle-type" data-type="{{id}}">
                                    <label class="custom-control-label" for="tpl-t-{{id}}">
                                        {{label}}
                                    </label>
                                </div>
                            </div>
                            {{/modtypes}}
                        </div>
                    </div>
                    <div class="mt-2">
                        <a href="#" class="small mr-3" data-action="select-all-types">
                            {{#str}}template_select_all, local_coursegen{{/str}}
                        </a>
                        <a href="#" class="small" data-action="deselect-all-types">
                            {{#str}}template_deselect_all, local_coursegen{{/str}}
                        </a>
                    </div>
                </div>
            </div>
            <hr>
            <div class="form-group row">
                <label class="col-md-3 col-form-label font-weight-bold">
                    {{#str}}template_naming_pattern, local_coursegen{{/str}}
                </label>
                <div class="col-md-9">
                    <select class="custom-select mb-2" data-field="naming-pattern">
                        <option value="Unidad {N} — {nombre}">Unidad {N} — {nombre}</option>
                        <option value="Módulo {N}: {nombre}">Módulo {N}: {nombre}</option>
                        <option value="Tema {N}: {nombre}">Tema {N}: {nombre}</option>
                        <option value="Semana {N}: {nombre}">Semana {N}: {nombre}</option>
                        <option value="{nombre}">{nombre} (name only)</option>
                        <option value="__custom__">Custom...</option>
                    </select>
                    <div class="d-none mb-2" data-region="custom-pattern">
                        <input type="text" class="form-control" data-field="custom-pattern"
                               placeholder="E.g.: Chapter {N} - {nombre}">
                        <small class="form-text text-muted">
                            {{#str}}template_naming_custom_help, local_coursegen{{/str}}
                        </small>
                    </div>
                    <div class="d-flex align-items-center mb-2">
                        <span class="text-muted small mr-2">
                            {{#str}}template_naming_start, local_coursegen{{/str}}
                        </span>
                        <select class="custom-select" style="width:70px" data-field="naming-start">
                            <option value="1">1</option>
                            <option value="0">0</option>
                        </select>
                    </div>
                    <div class="bg-light rounded p-2" data-region="naming-preview"></div>
                </div>
            </div>
        </div>

        <hr class="my-4">

        {{! Course structure — review only the rare exception to the kind defaults above }}
        <h4>{{#str}}template_configure_sections, local_coursegen{{/str}}</h4>
        <p class="text-muted">{{#str}}template_configure_sections_desc, local_coursegen{{/str}}</p>
        <div data-region="structure">
            <div data-region="sections-config">{{{sectionsconfightml}}}</div>
        </div>

        <hr class="my-4">

        {{! Name + Save }}
        <h4>{{#str}}template_summary_title, local_coursegen{{/str}}</h4>
        {{{nameformhtml}}}
        <div class="d-flex justify-content-end mt-3">
            <button class="btn btn-primary" data-action="save">
                {{#pix}}e/save, core{{/pix}}
                {{#str}}template_save, local_coursegen{{/str}}
            </button>
        </div>
    </div>
</div>
