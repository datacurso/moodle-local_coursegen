{{!
    @template local_coursegen/template_aimodify_modal_body

    The body of the modal of an activity "modified with AI": how the AI has to change it. The instruction is optional
    when the activity already has markers, and required when it has none.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="local_coursegen/template/aimodify-field" on the instruction textarea.

    Context variables required for this template:
    * uniqid string - Unique id of this render.
    * name string - The name of the activity.
    * instruction string - The instruction saved so far; may be empty.
    * hasmarkers bool - The activity has markers: the instruction is optional.

    Example context (json):
    {
        "name": "Guía didáctica",
        "instruction": "",
        "hasmarkers": false
    }
}}
<div class="form-group mb-0">
    <label for="{{uniqid}}-aimodify">{{#str}} template_aimodify_label, local_coursegen {{/str}}</label>
    <textarea class="form-control" id="{{uniqid}}-aimodify" rows="4" data-region="local_coursegen/template/aimodify-field"
              placeholder="{{#str}} template_aimodify_placeholder, local_coursegen, {{name}} {{/str}}">{{instruction}}</textarea>
    <small class="form-text text-muted">
        {{#hasmarkers}}{{#str}} template_aimodify_help_markers, local_coursegen {{/str}}{{/hasmarkers}}
        {{^hasmarkers}}{{#str}} template_aimodify_help_required, local_coursegen {{/str}}{{/hasmarkers}}
    </small>
</div>
