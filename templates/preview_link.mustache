{{!
    @template local_coursegen/preview_link

    One plain anchor, shared by every previewed module that used to build
    one with html_writer::link().

    Context variables required for this template:
    * url - string, the href.
    * text - string, the link text.

    Context variables optional for this template:
    * onclick - string, inline JS for a workaround link the real page opens
                as a popup or new tab.
}}
<a href="{{{url}}}"{{#onclick}} onclick="{{{onclick}}}"{{/onclick}}>{{{text}}}</a>
