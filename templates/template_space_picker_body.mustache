{{!
    @template local_coursegen/template_space_picker_body

    The body of the modal of "Add space for an activity": a search, the tabs of the activity chooser, and one activity
    per row at full width. Selecting an activity opens, right under its own row, the field of its instruction (and,
    when it is the only one, its optional name and, for a File, who provides it).

    Data attributes required for JS:
    * data-region="local_coursegen/template/space-picker-search" on the search field.
    * data-region="local_coursegen/template/space-picker-tab" on each tab (data-tab: all, activity, resource).
    * data-region="local_coursegen/template/space-picker-option" on each row (data-modname, data-kind, data-title).
    * data-region="local_coursegen/template/space-picker-toggle" on the part of the row that selects it.
    * data-region="local_coursegen/template/space-picker-info" and "space-picker-helptext": the help of the type.
    * data-region="local_coursegen/template/space-picker-panel" on what opens under a selected row.
    * data-region="local_coursegen/template/space-picker-label" and "space-picker-instruction": its instruction.
    * data-region="local_coursegen/template/space-picker-name-group" and "space-picker-name": the name of one.
    * data-region="local_coursegen/template/space-picker-mode-group", "space-picker-mode" (data-mode) and
      "space-picker-teacher-hint": who provides a File.
    * data-region="local_coursegen/template/space-picker-empty" on what shows when a search finds nothing.
    * data-region="local_coursegen/template/space-picker-required-group" and "space-picker-required" (radios): whether
      the space is required, under the list, with several activities or a File the teacher uploads.

    Context variables required for this template:
    * uniqid string - Unique id of this render.
    * options array - Each: modname, title, summary, help (core HTML), icon (core markup), purpose, kind, uploadable.

    Example context (json):
    {
        "options": [{"modname": "quiz", "title": "Quiz", "summary": "Questions graded automatically.", "help": "",
            "icon": "", "purpose": "assessment", "kind": "activity", "uploadable": false}]
    }
}}
<div class="tpl-sp">
    <input type="search" class="form-control" id="{{uniqid}}-search" autocomplete="off"
           data-region="local_coursegen/template/space-picker-search"
           placeholder="{{#str}} search, core {{/str}}" aria-label="{{#str}} search, core {{/str}}">
    <div class="nav nav-tabs mt-3" role="tablist">
        <button type="button" class="nav-link active" role="tab" aria-selected="true" data-tab="all"
                data-region="local_coursegen/template/space-picker-tab">{{#str}} all, core {{/str}}</button>
        <button type="button" class="nav-link" role="tab" aria-selected="false" data-tab="activity"
                data-region="local_coursegen/template/space-picker-tab">{{#str}} activities, core {{/str}}</button>
        <button type="button" class="nav-link" role="tab" aria-selected="false" data-tab="resource"
                data-region="local_coursegen/template/space-picker-tab">{{#str}} resources, core {{/str}}</button>
    </div>
    <ul class="tpl-sp-list" role="list">
        {{#options}}
        <li class="tpl-sp-item" data-region="local_coursegen/template/space-picker-option"
            data-modname="{{modname}}" data-kind="{{kind}}" data-title="{{title}}">
            <div class="tpl-sp-head">
                <button type="button" class="tpl-sp-toggle" role="checkbox" aria-checked="false"
                        aria-controls="{{uniqid}}-{{modname}}-panel"
                        data-region="local_coursegen/template/space-picker-toggle">
                    <span class="tpl-sp-check" aria-hidden="true"></span>
                    {{! The icon is markup built by Moodle core for the chooser, which core itself prints with triple braces. }}
                    <span class="tpl-sp-icon activityiconcontainer smaller {{purpose}}" aria-hidden="true">{{{icon}}}</span>
                    <span class="tpl-sp-text">
                        <span class="tpl-sp-name">{{title}}</span>
                        <span class="tpl-sp-desc">{{summary}}</span>
                    </span>
                </button>
                <button type="button" class="tpl-sp-info" aria-expanded="false"
                        aria-controls="{{uniqid}}-{{modname}}-help" data-region="local_coursegen/template/space-picker-info"
                        title="{{#str}} informationformodule, core_course, {{title}} {{/str}}"
                        aria-label="{{#str}} informationformodule, core_course, {{title}} {{/str}}">
                    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="7" fill="currentColor"/><path d="M8 7v4M8 4.6v.1" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
            </div>
            {{! The help is the text Moodle core gives each type, already formatted by core. }}
            <div class="tpl-sp-help" id="{{uniqid}}-{{modname}}-help" data-region="local_coursegen/template/space-picker-helptext" hidden>{{{help}}}</div>
            <div class="tpl-sp-panel" id="{{uniqid}}-{{modname}}-panel" data-region="local_coursegen/template/space-picker-panel" hidden>
                {{#uploadable}}
                <div class="tpl-sp-field" data-region="local_coursegen/template/space-picker-mode-group" hidden>
                    <span class="tpl-sp-label" id="{{uniqid}}-{{modname}}-mode">{{#str}} template_space_mode_label, local_coursegen {{/str}}</span>
                    <div class="btn-group" role="group" aria-labelledby="{{uniqid}}-{{modname}}-mode">
                        <button type="button" class="btn btn-outline-primary active" aria-pressed="true" data-mode="ai"
                                data-region="local_coursegen/template/space-picker-mode">{{#str}} template_space_mode_ai, local_coursegen {{/str}}</button>
                        <button type="button" class="btn btn-outline-primary" aria-pressed="false" data-mode="teacher"
                                data-region="local_coursegen/template/space-picker-mode">{{#str}} template_space_mode_teacher, local_coursegen {{/str}}</button>
                    </div>
                    <div class="form-text text-muted small mt-1" data-region="local_coursegen/template/space-picker-teacher-hint" hidden>{{#str}} template_space_mode_teacher_desc, local_coursegen {{/str}}</div>
                </div>
                {{/uploadable}}
                <div class="tpl-sp-field">
                    <label class="tpl-sp-label" for="{{uniqid}}-{{modname}}-instruction"
                           data-region="local_coursegen/template/space-picker-label"></label>
                    <textarea class="form-control" rows="3" id="{{uniqid}}-{{modname}}-instruction"
                              data-region="local_coursegen/template/space-picker-instruction"></textarea>
                </div>
                <div class="tpl-sp-field" data-region="local_coursegen/template/space-picker-name-group" hidden>
                    <label class="tpl-sp-label" for="{{uniqid}}-{{modname}}-name">{{#str}} template_space_name_label, local_coursegen {{/str}}</label>
                    <input type="text" class="form-control" id="{{uniqid}}-{{modname}}-name" maxlength="255"
                           data-region="local_coursegen/template/space-picker-name"
                           placeholder="{{#str}} template_space_name_placeholder_ai, local_coursegen {{/str}}">
                </div>
            </div>
        </li>
        {{/options}}
    </ul>
    <p class="text-muted mt-3 mb-0" data-region="local_coursegen/template/space-picker-empty" hidden>{{#str}} noresults, core {{/str}}</p>
    <fieldset class="tpl-sp-required" data-region="local_coursegen/template/space-picker-required-group" hidden>
        <legend class="tpl-sp-required-title">{{#str}} template_space_requirement_label, local_coursegen {{/str}}</legend>
        <div class="form-check">
            <input class="form-check-input" type="radio" name="{{uniqid}}-required" id="{{uniqid}}-required-yes" value="1" checked
                   data-region="local_coursegen/template/space-picker-required">
            <label class="form-check-label" for="{{uniqid}}-required-yes">
                <strong>{{#str}} template_space_required, local_coursegen {{/str}}</strong>
                <span class="d-block text-muted small">{{#str}} template_space_picker_required_desc, local_coursegen {{/str}}</span>
            </label>
        </div>
        <div class="form-check mt-2">
            <input class="form-check-input" type="radio" name="{{uniqid}}-required" id="{{uniqid}}-required-no" value="0"
                   data-region="local_coursegen/template/space-picker-required">
            <label class="form-check-label" for="{{uniqid}}-required-no">
                <strong>{{#str}} template_space_optional, local_coursegen {{/str}}</strong>
                <span class="d-block text-muted small">{{#str}} template_space_picker_optional_desc, local_coursegen {{/str}}</span>
            </label>
        </div>
    </fieldset>
</div>
