{{!
    @template local_coursegen/preview_scorm_attempt_status

    A previewed SCORM package's attempt standing, ported from
    scorm_get_attempt_status(). The reader has made no attempts, so the
    grade reported is always "none".

    Context variables required for this template:
    * allowedattempts - string.
    * attemptcount - int.
    * grademethod - string.
    * gradereported - string.
    * exceeded - bool.
}}
<p>
    {{#str}} noattemptsallowed, scorm {{/str}}: {{allowedattempts}}<br>
    {{#str}} noattemptsmade, scorm {{/str}}: {{attemptcount}}<br>
    {{#str}} grademethod, scorm {{/str}}: {{grademethod}}<br>
    {{#str}} gradereported, scorm {{/str}}: {{gradereported}}<br>
</p>
{{#exceeded}}
<p class="exceededmaxattempts">{{#str}} exceededmaxattempts, scorm {{/str}}</p>
{{/exceeded}}
