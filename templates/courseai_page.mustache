{{!
    @template local_coursegen/courseai_page

    AI Course Creation Wizard page layout: sidebar, the context step (main
    composer and planning chat column), the resizable splitter, the planning
    view, the sessions list view and the inline data element read by the
    JavaScript. Each area is a partial under local_coursegen/local/courseai/.

    Classes required for JS:
    * is-planning on the workspace (set when the page resumes a session)

    Data attributes required for JS:
    * data-guidelines, data-languages, data-defaultlang on #courseai-data
      (fallback bootstrap data when the AMD init parameters are empty)

    Context variables required for this template:
    * logourl string - Sidebar logo URL
    * guidelines string - JSON-encoded guidelines list
    * languages string - JSON-encoded language options
    * defaultlang string - Default language code
    * hassessions bool - True when the user has sessions
    * sessions array - Recent sessions for the sidebar (id, title, statuslabel)
    * allsessions array - All sessions for the sessions list view
    * isresuming bool - True when the page resumes an existing session
    * subsectionsenabled bool - Render the "with subsections" toggles
    * compactcomposer object - {"compact": true} for the compact composer partials
    * guidelinelist object - Initial (empty) guideline list context

    Example context (json):
    {
        "logourl": "https://example.com/local/coursegen/pix/logo.png",
        "guidelines": "[{\"id\":\"si_1\",\"name\":\"Example\",\"category\":\"General\",\"description\":\"...\"}]",
        "languages": "[{\"code\":\"es\",\"name\":\"Español (es)\"}]",
        "defaultlang": "es",
        "hassessions": true,
        "sessions": [
            {"id": 1, "title": "Sample session", "statuslabel": "Pending"}
        ],
        "allsessions": [
            {"id": 1, "title": "Sample session", "statuslabel": "Pending", "timecreated": "1 January 2026"}
        ],
        "isresuming": false,
        "subsectionsenabled": true,
        "compactcomposer": {"compact": true},
        "guidelinelist": {
            "listlabel": "Guidelines list",
            "emptytext": "No results",
            "hasitems": false,
            "items": []
        }
    }
}}

{{! Wizard CSS is loaded via PHP $PAGE->requires->css() }}

{{> local_coursegen/sidebar }}
<div class="courseai-sidebar-backdrop" id="courseaiSidebarBackdrop"></div>

<main class="app-main aicoursecreation-main">
  <div class="container">
    <div class="courseai-workspace{{#isresuming}} is-planning{{/isresuming}}" id="courseaiWorkspace">

      {{! Context step: in planning mode the editor is hidden by CSS and the chat
          column shows instead, so on reload the real chrome renders and only the
          service-driven content areas show skeletons. }}
      <div class="context-wrap" id="contextView">
        {{> local_coursegen/local/courseai/composer }}
        {{> local_coursegen/local/courseai/context_chat }}
      </div>

      {{! Resizable divider, visible only in .is-planning (3-column grid).
          aria-valuemin/max/now are set by the splitter AMD at init: the HTML
          validator rejects them as static attributes on role="separator". }}
      <div class="cg-splitter" id="cgSplitter" role="separator" aria-orientation="vertical" tabindex="0"
           aria-label="{{#str}}courseai_resize_panels, local_coursegen{{/str}}"></div>

      {{> local_coursegen/local/courseai/planning_view }}

    </div>
  </div>

  {{> local_coursegen/local/courseai/sessions_list }}
</main>

{{! Data passed to JavaScript }}
<div id="courseai-data" class="hidden"
     data-guidelines="{{guidelines}}"
     data-languages="{{languages}}"
     data-defaultlang="{{defaultlang}}">
</div>
