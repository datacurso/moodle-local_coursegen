  <!-- Sessions list view (hidden by default). Header + toolbar + column
       labels are one sticky block inside the SAME scroller as the rest of
       the page (.aicoursecreation-main) — no separate inner scrollbox. -->
  <div class="courseai-sessions-view" id="courseaiSessionsView" style="display:none">
    <div class="courseai-sessions-sticky">
      <div class="courseai-sessions-header">
        <h2>{{#str}}courseai_sessions_title, local_coursegen{{/str}}</h2>
        <a class="courseai-sessions-create-btn" href="aicoursecreation.php">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
          {{#str}}courseai_sessions_newbtn, local_coursegen{{/str}}
        </a>
      </div>

      {{#hassessions}}
      <div class="courseai-sessions-toolbar">
        <div class="courseai-sessions-search">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
          <input type="search" id="courseaiSessionsSearch"
                 placeholder="{{#str}}courseai_sessions_search, local_coursegen{{/str}}">
        </div>
        <select id="courseaiSessionsStatusFilter" class="courseai-sessions-filter">
          <option value="">{{#str}}courseai_sessions_filter_all, local_coursegen{{/str}}</option>
          <option value="1">{{#str}}status_pending, local_coursegen{{/str}}</option>
          <option value="2">{{#str}}status_creating, local_coursegen{{/str}}</option>
          <option value="4">{{#str}}status_failed, local_coursegen{{/str}}</option>
        </select>
      </div>

      <div class="courseai-sessions-columns" role="row">
        <span role="columnheader">{{#str}}courseai_sessions_col_name, local_coursegen{{/str}}</span>
        <span role="columnheader">{{#str}}courseai_sessions_col_status, local_coursegen{{/str}}</span>
        <span role="columnheader">{{#str}}courseai_sessions_col_created, local_coursegen{{/str}}</span>
      </div>
      {{/hassessions}}
    </div>

    {{#hassessions}}
    <div class="courseai-sessions-table" role="table" id="courseaiSessionsGrid">
      {{#allsessions}}
      <div class="courseai-session-row" role="row" data-sessionid="{{id}}" data-status="{{status}}" data-title="{{title}}">
        <span class="courseai-session-row-name" role="cell">
          <a href="aicoursecreation.php?sessionid={{id}}">{{title}}</a>
        </span>
        <span role="cell"><span class="courseai-session-row-status">{{statuslabel}}</span></span>
        <span class="courseai-session-row-date" role="cell">{{timecreated}}</span>
      </div>
      {{/allsessions}}
    </div>

    <div class="courseai-sessions-noresults" id="courseaiSessionsNoResults" style="display:none">
      {{#str}}courseai_sessions_noresults, local_coursegen{{/str}}
    </div>

    <div class="courseai-sessions-pagination" id="courseaiSessionsPagination" style="display:none">
      <button class="courseai-pagination-btn courseai-pagination-prev" id="courseaiPaginationPrev" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
      </button>
      <span class="courseai-pagination-info" id="courseaiPaginationInfo"></span>
      <button class="courseai-pagination-btn courseai-pagination-next" id="courseaiPaginationNext" type="button">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 18 15 12 9 6"/>
        </svg>
      </button>
    </div>
    {{/hassessions}}

    {{^hassessions}}
    <div class="courseai-sessions-empty">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </svg>
      <p>{{#str}}courseai_sessions_empty, local_coursegen{{/str}}</p>
      <a href="aicoursecreation.php">{{#str}}courseai_sessions_newbtn, local_coursegen{{/str}}</a>
    </div>
    {{/hassessions}}
  </div>

</main>
</div><!-- .courseai-app-layout -->

<!-- Guideline preview modal (Bootstrap 4) -->
<div class="modal fade" id="guidelinePreviewModal" tabindex="-1" role="dialog" aria-labelledby="previewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered preview-dialog" role="document">
    <div class="modal-content preview-modal-content">

      <!-- Circle-X close button (top right) -->
      <button type="button" class="preview-close" data-dismiss="modal" aria-label="{{#str}}courseai_modal_close, local_coursegen{{/str}}">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
      </button>

      <!-- Header -->
      <div class="preview-header">
        <div class="preview-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary);flex-shrink:0" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>
          </svg>
          <span id="previewModalLabel"></span>
        </div>
        <div class="preview-subtitle">
          <span class="preview-cat-badge" id="previewModalCategory"></span>
          <span class="preview-subtitle-text">{{#str}}courseai_modal_fullcontext, local_coursegen{{/str}}</span>
        </div>
      </div>

      <!-- Description box -->
      <div class="preview-body">
        <div class="preview-desc-box">
          <p id="previewModalBody"></p>
        </div>
      </div>

    </div>
  </div>
</div>

