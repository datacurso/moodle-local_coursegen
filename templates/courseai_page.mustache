            <button type="button" class="btn btn-primary" id="reviewConfirmBtn">
              {{#str}}courseai_review_confirm, local_coursegen{{/str}}
            </button>
          </div>
        </div>
      </div>

    </div>

    </div><!-- .courseai-workspace -->

