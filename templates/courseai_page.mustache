{{!
    @template local_coursegen/courseai_page

    AI Course Creation Wizard - Step 1: Context

    Example context (json):
    {
        "guidelines": "[{\"id\":\"si_1\",\"name\":\"Example\",\"category\":\"General\",\"description\":\"...\"}]",
        "languages": "[{\"code\":\"es\",\"name\":\"Español (es)\"}]",
        "defaultlang": "es"
    }
}}

{{! Wizard CSS will be loaded via PHP $PAGE->requires->css() }}

<!-- ══════════════════════ APP LAYOUT ══════════════════════════════════ -->
<div class="courseai-app-layout" id="courseaiAppLayout">

<!-- ══════════════════════ SIDEBAR ════════════════════════════════════ -->
{{> local_coursegen/sidebar }}

<!-- ══════════════════════ MAIN ════════════════════════════════════════ -->
<button class="courseai-sidebar-expand-btn" id="courseaiSidebarExpand" type="button"
        title="{{#str}}courseai_sidebar_toggle, local_coursegen{{/str}}">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="2"/><line x1="9" y1="3" x2="9" y2="21"/>
  </svg>
</button>
<main class="app-main aicoursecreation-main" style="position:relative">
  <div class="container">
    <div class="courseai-workspace{{#isresuming}} is-planning{{/isresuming}}" id="courseaiWorkspace">

    <!-- Context step form (in planning mode the editor is hidden by CSS and the
         left chat column shows instead — so on reload the real chrome renders and
         only the service-driven content areas show skeletons). -->
    <div class="context-wrap" id="contextView">

      <div class="courseai-context-editor" id="courseaiContextEditor">

      <div class="context-head">
        <h2>{{#str}}courseai_context_title, local_coursegen{{/str}}</h2>
        <p>{{#str}}courseai_context_subtitle, local_coursegen{{/str}}</p>
      </div>

      <!-- Card -->
      <div class="card" id="mainCard">

        <!-- Prompt textarea -->
        <textarea
          id="promptInput"
          class="prompt-textarea"
          placeholder="{{#str}}courseai_prompt_placeholder, local_coursegen{{/str}}"
          rows="5"
          aria-label="{{#str}}courseai_prompt_arialabel, local_coursegen{{/str}}"
        ></textarea>

        <!-- Selected chips (syllabus + guideline) -->
        <div class="chips-row" id="chipsRow" style="display:none">

          <!-- Syllabus chip (shown after file attach) -->
          <span class="chip chip-syllabus hidden" id="chipSyllabus">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            <span class="chip-name" id="chipSyllabusName"></span>
            <button class="chip-btn" onclick="clearSyllabus()" aria-label="{{#str}}courseai_chip_remove_syllabus, local_coursegen{{/str}}">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </span>

          <!-- Guideline chip (shown after selecting a guideline) -->
          <span class="chip chip-guideline hidden" id="chipGuideline">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span class="chip-name" id="chipGuidelineName"></span>
            <button class="chip-btn" id="chipGuidelineEyeBtn" aria-label="{{#str}}courseai_chip_view_guideline, local_coursegen{{/str}}">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
            <button class="chip-btn" onclick="clearGuideline()" aria-label="{{#str}}courseai_chip_remove_guideline, local_coursegen{{/str}}">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </span>

          <!-- Template chip (shown after selecting a template) -->
          <span class="chip chip-template hidden" id="chipTemplate">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
            <span class="chip-name" id="chipTemplateName"></span>
            <button class="chip-btn" id="chipTemplateRemoveBtn" aria-label="{{#str}}courseai_chip_remove_template, local_coursegen{{/str}}">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </span>

        </div>

        <!-- Bottom toolbar -->
        <div class="card-toolbar">
          <div class="tbar-left">

            <!-- "+" options menu (ChatGPT-style): every creation setting lives inside -->
            <div class="plus-menu-wrap popover-wrap">
              <button class="plus-menu-btn" id="btnPlusMenu" type="button"
                      title="{{#str}}courseai_options_menu, local_coursegen{{/str}}"
                      aria-label="{{#str}}courseai_options_menu, local_coursegen{{/str}}"
                      aria-haspopup="true" aria-expanded="false">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
              </button>

              <div class="plus-menu-panel" id="plusMenuPanel" role="menu" aria-label="{{#str}}courseai_options_menu, local_coursegen{{/str}}">

                <!-- Template: opens a searchable popover (same pattern as guidelines) -->
                <button class="plus-menu-item" id="btnTemplates" title="{{#str}}courseai_btn_templates_title, local_coursegen{{/str}}" type="button" role="menuitem" aria-haspopup="dialog" aria-expanded="false" aria-controls="templatesPopover">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                  <span class="plus-menu-item__label">{{#str}}courseai_btn_templates, local_coursegen{{/str}}</span>
                  <span class="template-badge hidden" id="templateBadge"></span>
                </button>

                <!-- Sílabo (original button, restyled as menu item) -->
                <button class="plus-menu-item" id="btnSyllabus" title="{{#str}}courseai_btn_syllabus_title, local_coursegen{{/str}}" type="button" role="menuitem">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                  </svg>
                  <span class="plus-menu-item__label">{{#str}}courseai_btn_syllabus, local_coursegen{{/str}}</span>
                </button>

                <!-- Directrices (original button, restyled as menu item) -->
                <button class="plus-menu-item" id="btnDirectrices" title="{{#str}}courseai_btn_guidelines_title, local_coursegen{{/str}}" type="button" role="menuitem" aria-haspopup="dialog" aria-expanded="false" aria-controls="guidelinesPopover">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                  </svg>
                  <span class="plus-menu-item__label">{{#str}}courseai_btn_guidelines, local_coursegen{{/str}}</span>
                  <span class="guideline-badge hidden" id="guidelineBadge"></span>
                </button>

                <!-- Idioma: opens a searchable popover (same pattern as guidelines) -->
                <button class="plus-menu-item" id="pmLangItem" type="button" role="menuitem"
                        aria-haspopup="dialog" aria-controls="langPopover"
                        title="{{#str}}courseai_lang_title, local_coursegen{{/str}}">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                  <span class="plus-menu-item__label">{{#str}}courseai_lang_menu_label, local_coursegen{{/str}}</span>
                  <span class="plus-menu-item__value" id="pmLangValue"></span>
                  <svg class="plus-menu-item__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="9 18 15 12 9 6"/>
                  </svg>
                </button>

                <!-- With images toggle switch -->
                <div class="tbar-toggle-wrap plus-menu-item plus-menu-item--toggle" title="{{#str}}courseai_images_title, local_coursegen{{/str}}" role="menuitemcheckbox" aria-checked="false" tabindex="0">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
                    <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                  <span class="plus-menu-item__label tbar-toggle-label">{{#str}}courseai_images_label, local_coursegen{{/str}}</span>
                  <div class="toggle-track" id="imgToggleTrack">
                    <div class="toggle-thumb"></div>
                  </div>
                  <input type="checkbox" id="btnWithImages" class="hidden" aria-label="{{#str}}courseai_images_arialabel, local_coursegen{{/str}}">
                </div>

                {{#subsectionsenabled}}
                <!-- With subsections toggle switch -->
                <div class="tbar-toggle-wrap plus-menu-item plus-menu-item--toggle" title="{{#str}}courseai_subsections_title, local_coursegen{{/str}}" role="menuitemcheckbox" aria-checked="false" tabindex="0">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
                    <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                    <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
                    <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                  </svg>
                  <span class="plus-menu-item__label tbar-toggle-label">{{#str}}courseai_subsections_label, local_coursegen{{/str}}</span>
                  <div class="toggle-track" id="subToggleTrack">
                    <div class="toggle-thumb"></div>
                  </div>
                  <input type="checkbox" id="btnWithSubsections" class="hidden" aria-label="{{#str}}courseai_subsections_arialabel, local_coursegen{{/str}}">
                </div>
                {{/subsectionsenabled}}

              </div>

              <!-- Language popover: searchable list, same pattern as guidelines -->
              <div class="popover-panel popover-panel--down" id="langPopover" role="dialog" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}">
                <button class="pop-close-btn" id="langPopoverClose" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
                <div class="pop-search-row">
                  <div class="pop-search-inner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="11" cy="11" r="8"/>
                      <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input type="text" id="langSearch" placeholder="{{#str}}courseai_lang_search_placeholder, local_coursegen{{/str}}" autocomplete="off" />
                  </div>
                </div>
                <ul class="pop-list" id="langList" role="listbox" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}"></ul>
              </div>

              <!-- Guidelines popover: anchored to the "+" area so it opens next to the menu -->
              <div class="popover-panel popover-panel--down" id="guidelinesPopover" role="dialog" aria-label="{{#str}}courseai_guidelines_dialog_label, local_coursegen{{/str}}">
                <button class="pop-close-btn" id="guidelinesPopoverClose" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
                <div class="pop-search-row">
                  <div class="pop-search-inner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="11" cy="11" r="8"/>
                      <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input type="text" id="guidelineSearch" placeholder="{{#str}}courseai_guidelines_search_placeholder, local_coursegen{{/str}}" autocomplete="off" />
                  </div>
                  <p class="pop-note">{{#str}}courseai_guidelines_note_one, local_coursegen{{/str}}</p>
                </div>
                <ul class="pop-list" id="guidelineList" role="listbox" aria-label="{{#str}}courseai_guidelines_list_label, local_coursegen{{/str}}"></ul>
              </div>

              <!-- Templates popover: searchable list -->
              <div class="popover-panel popover-panel--down" id="templatesPopover" role="dialog" aria-label="{{#str}}courseai_templates_dialog_label, local_coursegen{{/str}}">
                <button class="pop-close-btn" id="templatesPopoverClose" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                  </svg>
                </button>
                <div class="pop-search-row">
                  <div class="pop-search-inner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="11" cy="11" r="8"/>
                      <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input type="text" id="templateSearch" placeholder="{{#str}}courseai_templates_search_placeholder, local_coursegen{{/str}}" autocomplete="off" />
                  </div>
                </div>
                <ul class="pop-list" id="templateList" role="listbox" aria-label="{{#str}}courseai_templates_list_label, local_coursegen{{/str}}"></ul>
              </div>
            </div>

            <!-- Hidden file manager container for Moodle file picker -->
            <div class="hidden" id="syllabusFilemanager"></div>

            <!-- Hidden language select: still the single source of truth for state/lang -->
            <select class="tbar-select hidden" id="langSelect" title="{{#str}}courseai_lang_title, local_coursegen{{/str}}" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}">
              <option value="es">🌐 ES</option>
              <option value="en">🌐 EN</option>
            </select>

          </div>

          <div class="tbar-right">
            <span class="kbd-hint">{{#str}}courseai_hint_enter, local_coursegen{{/str}}</span>
            <button class="btn-generate" id="btnGenerate" type="button">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
              </svg>
              {{#str}}courseai_btn_generate, local_coursegen{{/str}}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5M5 12l7-7 7 7"/>
              </svg>
            </button>
          </div>
        </div>

      </div><!-- .card -->

      <p class="form-tip">{{#str}}courseai_form_tip, local_coursegen{{/str}}</p>

      </div>

      <div class="courseai-context-chat" id="courseaiContextChat">

        <!-- Decision card (WU4): on review_needed it takes the composer's slot at the
             bottom of the chat column — the message thread above stays visible. CSS
             order:10 pins it last; decision-overlay.js toggles display. -->
        <div class="cg-decision-overlay" id="cgDecisionOverlay" style="display:none" role="group"
             aria-label="{{#str}}courseai_decision_title, local_coursegen{{/str}}">
          <div class="cg-decision-card">
            <p class="cg-decision-title">{{#str}}courseai_decision_title, local_coursegen{{/str}}</p>
            <p class="cg-decision-subtitle">{{#str}}courseai_decision_subtitle, local_coursegen{{/str}}</p>
            <div class="cg-decision-body" id="cgDecisionBody"></div>
            <div class="cg-decision-actions">
              <button class="cg-decision-btn cg-decision-btn--accept" id="cgDecisionAccept" type="button">
                {{#str}}courseai_decision_accept, local_coursegen{{/str}}
              </button>
              <button class="cg-decision-btn cg-decision-btn--adjust" id="cgDecisionAdjust" type="button">
                {{#str}}courseai_decision_adjust, local_coursegen{{/str}}
              </button>
            </div>
          </div>
        </div>

        <div class="courseai-chat-scroll cg-thread" id="courseaiChatScroll">
          <div class="courseai-round" data-round="0">
            <!-- Conversation thread (§7.1): one continuous chronological feed.
                 The initial prompt is the FIRST user turn (emitted via emitLog),
                 followed by AI planning turns. No rigid "INITIAL MESSAGE" block
                 and no uppercase section labels — it reads top-to-bottom. -->
            <div class="cg-log cg-thread-feed" id="cgLog" aria-live="polite"
                 aria-label="{{#str}}courseai_log_label, local_coursegen{{/str}}"></div>

            <!-- Left loading skeleton: previews the checklist shape while the
                 first instruction streams (hidden once a section arrives). -->
            <div class="cg-sk-checks-wrap" id="cgLeftSkeleton" style="display:none">{{> local_coursegen/courseai_skeleton_checks }}</div>

            <!-- Section checklist: a compact result card inside the AI planning
                 turn. The data hooks (data-section-id/data-round/data-remaining on
                 each <li>) are consumed by the streaming handlers — do not remove. -->
            <div class="courseai-checklist cg-thread-checklist hidden" id="courseaiChecklist">
              <div class="cg-group-head" role="button" tabindex="0" aria-expanded="true">
                <span class="cg-group-chevron" aria-hidden="true">⌄</span>
                <span class="cg-group-avatar" aria-hidden="true"></span>
                <span class="cg-group-title">{{#str}}courseai_log_ai_planned_structure, local_coursegen{{/str}}</span>
                <span class="cg-group-count"></span>
              </div>
              <ul class="courseai-checklist-list" id="courseaiChecklistList"></ul>
            </div>

            <!-- Continuation of the thread (§7.1): once the plan settles, user
                 actions and their results flow chronologically below the checklist. -->
            <div class="cg-log cg-thread-feed" id="cgLogAfter" aria-live="polite"></div>
          </div>

          <!-- Adjustment message history (shown after user sends adjustments) -->
          <div class="courseai-adjustment-history hidden" id="courseaiAdjustmentHistory"></div>
        </div>

        <!-- After "Adjust", the decision card is replaced by the composer; this slim
             bar (a SEPARATE element above the composer, with a gap) keeps Accept
             reachable so the user can always change their mind. -->
        <div class="cg-accept-bar" id="cgAcceptBar" style="display:none">
          <span class="cg-accept-bar-text">{{#str}}courseai_decision_still_accept, local_coursegen{{/str}}</span>
          <button class="cg-accept-bar-btn" id="cgAcceptInline" type="button">{{#str}}courseai_decision_accept, local_coursegen{{/str}}</button>
        </div>

        <!-- Pinned working-status slot: during an ACTION re-stream (reorder, replan,
             add, delete, adjust) the composer is hidden, so the "assistant is working"
             feedback is shown HERE — in the bottom slot where the composer/decision
             card sit — instead of as a chat turn floating over the empty composer void
             ("the message goes way down"). Empty (display:none via :empty) otherwise. -->
        <div class="cg-working-slot" id="cgWorkingSlot" aria-live="polite"></div>

        <!-- Compact chat for regeneration -->
        <div class="compact-chat-card" id="compactChatCard"{{^isresuming}} style="display:none"{{/isresuming}}>
          <textarea
            id="compactPromptInput"
            class="compact-prompt-textarea"
            placeholder="{{#str}}courseai_compact_prompt_placeholder, local_coursegen{{/str}}"
            rows="3"
            aria-label="{{#str}}courseai_prompt_arialabel, local_coursegen{{/str}}"
          ></textarea>

          <!-- Chips row (same as main card) -->
          <div class="chips-row" id="compactChipsRow" style="display:none">
            <span class="chip chip-syllabus hidden" id="compactChipSyllabus">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
