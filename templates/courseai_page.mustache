                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/>
                      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    <span class="plus-menu-item__label">{{#str}}courseai_lang_menu_label, local_coursegen{{/str}}</span>
                    <span class="plus-menu-item__value" id="pmCompactLangValue"></span>
                    <svg class="plus-menu-item__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <polyline points="9 18 15 12 9 6"/>
                    </svg>
                  </button>

                  <div class="tbar-toggle-wrap plus-menu-item plus-menu-item--toggle" title="{{#str}}courseai_images_title, local_coursegen{{/str}}" role="menuitemcheckbox" aria-checked="false" tabindex="0">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
                      <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                    <span class="plus-menu-item__label tbar-toggle-label">{{#str}}courseai_images_label, local_coursegen{{/str}}</span>
                    <div class="toggle-track" id="compactImgToggleTrack">
                      <div class="toggle-thumb"></div>
                    </div>
                    <input type="checkbox" id="btnCompactWithImages" class="hidden" aria-label="{{#str}}courseai_images_arialabel, local_coursegen{{/str}}">
                  </div>

                  {{#subsectionsenabled}}
                  <div class="tbar-toggle-wrap plus-menu-item plus-menu-item--toggle" title="{{#str}}courseai_subsections_title, local_coursegen{{/str}}" role="menuitemcheckbox" aria-checked="false" tabindex="0">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
                      <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                      <line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/>
                      <line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>
                    </svg>
                    <span class="plus-menu-item__label tbar-toggle-label">{{#str}}courseai_subsections_label, local_coursegen{{/str}}</span>
                    <div class="toggle-track" id="compactSubToggleTrack">
                      <div class="toggle-thumb"></div>
                    </div>
                    <input type="checkbox" id="btnCompactWithSubsections" class="hidden" aria-label="{{#str}}courseai_subsections_arialabel, local_coursegen{{/str}}">
                  </div>
                  {{/subsectionsenabled}}

                </div>

                <div class="popover-panel" id="langPopoverCompact" role="dialog" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}">
                  <button class="pop-close-btn" id="langPopoverCompactClose" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                  </button>
                  <div class="pop-search-row">
                    <div class="pop-search-inner">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                      </svg>
                      <input type="text" id="langSearchCompact" placeholder="{{#str}}courseai_lang_search_placeholder, local_coursegen{{/str}}" autocomplete="off" />
                    </div>
                  </div>
                  <ul class="pop-list" id="langListCompact" role="listbox" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}"></ul>
                </div>

                <div class="popover-panel" id="guidelinesPopoverCompact" role="dialog" aria-label="{{#str}}courseai_guidelines_dialog_label, local_coursegen{{/str}}">
                  <button class="pop-close-btn" id="guidelinesPopoverCompactClose" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                  </button>
                  <div class="pop-search-row">
                    <div class="pop-search-inner">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                      </svg>
                      <input type="text" id="guidelineSearchCompact" placeholder="{{#str}}courseai_guidelines_search_placeholder, local_coursegen{{/str}}" autocomplete="off" />
                    </div>
                    <p class="pop-note">{{#str}}courseai_guidelines_note_one, local_coursegen{{/str}}</p>
                  </div>
                  <ul class="pop-list" id="guidelineListCompact" role="listbox" aria-label="{{#str}}courseai_guidelines_list_label, local_coursegen{{/str}}"></ul>
                </div>

                <!-- Templates popover (compact): searchable list -->
                <div class="popover-panel" id="templatesPopoverCompact" role="dialog" aria-label="{{#str}}courseai_templates_dialog_label, local_coursegen{{/str}}">
                  <button class="pop-close-btn" id="templatesPopoverCompactClose" type="button" aria-label="{{#str}}closebuttontitle, core{{/str}}">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                  </button>
                  <div class="pop-search-row">
                    <div class="pop-search-inner">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                      </svg>
                      <input type="text" id="templateSearchCompact" placeholder="{{#str}}courseai_templates_search_placeholder, local_coursegen{{/str}}" autocomplete="off" />
                    </div>
                  </div>
                  <ul class="pop-list" id="templateListCompact" role="listbox" aria-label="{{#str}}courseai_templates_list_label, local_coursegen{{/str}}"></ul>
                </div>
              </div>

              <!-- Hidden compact language select: mirrored source of truth -->
              <select class="tbar-select hidden" id="compactLangSelect" title="{{#str}}courseai_lang_title, local_coursegen{{/str}}" aria-label="{{#str}}courseai_lang_arialabel, local_coursegen{{/str}}">
                <option value="es">🌐 ES</option>
                <option value="en">🌐 EN</option>
              </select>
            </div>

            <div class="compact-toolbar-right">
              <button class="btn-compact-regenerate" id="btnCompactRegenerate" type="button" aria-label="{{#str}}courseai_btn_regenerate, local_coursegen{{/str}}" title="{{#str}}courseai_btn_regenerate, local_coursegen{{/str}}">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 19V5M5 12l7-7 7 7"/>
                </svg>
              </button>
              <button class="btn-stop-resume btn-stop" id="btnStopExec" type="button"
                      style="display:none"
                      aria-label="{{#str}}courseai_btn_stop, local_coursegen{{/str}}"
                      title="{{#str}}courseai_btn_stop, local_coursegen{{/str}}">
                {{#str}}courseai_btn_stop, local_coursegen{{/str}}
              </button>
              <button class="btn-stop-resume btn-resume" id="btnResumeExec" type="button"
                      style="display:none"
                      aria-label="{{#str}}courseai_btn_resume, local_coursegen{{/str}}"
                      title="{{#str}}courseai_btn_resume, local_coursegen{{/str}}">
                {{#str}}courseai_btn_resume, local_coursegen{{/str}}
              </button>
            </div>
          </div>
        </div>
      </div>

    </div><!-- .context-wrap -->

    <!-- ══════════ TEMPLATE MODE VIEW ════════════════════════════════════ -->
    <div class="context-wrap" id="templateModeView" style="display:none">
      <div class="courseai-context-editor">
        <div class="context-head">
          <h2>{{#str}}courseai_template_title, local_coursegen{{/str}}</h2>
          <p>{{#str}}courseai_template_subtitle, local_coursegen{{/str}}</p>
        </div>

        <div class="card" id="templateModeCard">
          <div class="p-3">
            {{! Template selector }}
            <div class="form-row mb-3">
              <div class="col-md-8">
                <label class="font-weight-bold small">{{#str}}managetemplates, local_coursegen{{/str}}</label>
                <select class="custom-select" id="tplModeSelect">
                  <option value="">— {{#str}}template_select_course, local_coursegen{{/str}} —</option>
                  {{#coursetemplates}}
                  <option value="{{id}}">{{name}}</option>
                  {{/coursetemplates}}
                </select>
              </div>
              <div class="col-md-4">
                <label class="font-weight-bold small">{{#str}}category{{/str}}</label>
                <select class="custom-select" id="tplModeCategory">
                  <option value="">{{#str}}courseai_category_general, local_coursegen{{/str}}</option>
                </select>
              </div>
            </div>

            {{! Course names }}
            <div class="form-row mb-3">
              <div class="col-md-8">
                <label class="font-weight-bold small">
                  {{#str}}fullnamecourse{{/str}} <span class="text-danger">*</span>
                </label>
                <input type="text" class="form-control" id="tplModeFullname"
                       placeholder="{{#str}}courseai_review_fullname_placeholder, local_coursegen{{/str}}">
              </div>
              <div class="col-md-4">
                <label class="font-weight-bold small">{{#str}}shortnamecourse{{/str}}</label>
                <input type="text" class="form-control" id="tplModeShortname"
                       placeholder="{{#str}}courseai_review_shortname_placeholder, local_coursegen{{/str}}">
                <small class="form-text text-muted">
                  {{#str}}courseai_review_shortname_note, local_coursegen{{/str}}
                </small>
              </div>
            </div>

            {{! Language }}
            <div class="form-row mb-3">
              <div class="col-md-4">
                <label class="font-weight-bold small">{{#str}}course_ai_language, local_coursegen{{/str}}</label>
                <select class="custom-select" id="tplModeLang">
                </select>
              </div>
            </div>

            {{! Global instructions }}
            <div class="mb-3">
              <label class="font-weight-bold small">
                {{#str}}courseai_template_instructions, local_coursegen{{/str}}
              </label>
              <textarea class="form-control" rows="2" id="tplModeInstructions"
                        placeholder="{{#str}}courseai_template_instructions_placeholder, local_coursegen{{/str}}"></textarea>
              <small class="form-text text-muted">
                {{#str}}courseai_template_instructions_help, local_coursegen{{/str}}
              </small>
            </div>

            {{! Dynamic structure — populated by JS when template is selected }}
            <div id="tplModeStructure"></div>
          </div>

          {{! Toolbar }}
          <div class="prompt-bar" style="border-top:1px solid var(--border);padding:.5rem 1rem;display:flex;align-items:center">
            <span class="text-muted small" id="tplModeStats"></span>
            <button class="btn-generate ml-auto" id="tplModeGenerate" type="button" disabled>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
              </svg>
              {{#str}}courseai_btn_generate, local_coursegen{{/str}}
            </button>
          </div>
        </div>
      </div>
    </div><!-- #templateModeView -->

    <!-- Resizable divider (§2.1) — visible only in .is-planning (3-column grid) -->
    {{! aria-valuemin/max/now are set by the splitter AMD at init: the HTML
        validator rejects them as static attributes on role="separator". }}
    <div class="cg-splitter" id="cgSplitter" role="separator" aria-orientation="vertical" tabindex="0"
         aria-label="{{#str}}courseai_resize_panels, local_coursegen{{/str}}"></div>

    <!-- Step 2: Planning view -->
    <div class="planning-wrap" id="planningView" style="display:{{#isresuming}}flex{{/isresuming}}{{^isresuming}}none{{/isresuming}}">
      <div class="pc-card" id="planningProgressCard" style="display:none">
        <div class="pc-card-main">
          <span class="pc-icon-wrap" id="pcIconWrap" aria-hidden="true">
            <svg id="planningSpinner" class="pc-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
            <svg id="planningCheckIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" style="display:none">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </span>
          <div class="pc-info">
            <span class="pc-step" id="pcStep">{{#str}}courseai_state_planning, local_coursegen{{/str}}</span>
            <h3 class="pc-title" id="pcTitle">{{#str}}courseai_state_structuring, local_coursegen{{/str}}</h3>
            <p class="pc-subtitle" id="pcSubtitle"></p>
          </div>
        </div>

        <div class="pc-progress-wrap">
          <div class="pc-progress-row">
            <span class="pc-progress-label">{{#str}}courseai_progress_label, local_coursegen{{/str}}</span>
            <span class="pc-progress-pct" id="pcPct">0{{#str}}courseai_progress_percent, local_coursegen{{/str}}</span>
          </div>
          <div class="pc-bar-track">
            <div class="pc-bar-fill" id="pcBarFill" style="width:0%"></div>
          </div>
        </div>

        <div class="pc-toggle-row" id="pcToggleRow" style="display:none">
          <button class="pc-toggle-btn" id="pcToggleBtn" type="button" aria-expanded="false">
            <svg class="pc-chevron" id="pcChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
            {{#str}}courseai_toggle_details, local_coursegen{{/str}}
          </button>
        </div>

        <div class="pc-details-panel" id="pcDetailsPanel" style="display:none"></div>
      </div>

      <!-- Legacy loader element kept for compatibility (toggled by stream code);
           the visible loader is the in-place skeleton below. -->
      <div class="planning-loading" id="planningLoading" style="display:none"></div>

      <!-- Initial-streaming loader: an in-place skeleton that previews the
           detailed-plan card shape (no full-screen spinner). Shown while the
           first instruction streams, hidden once the first section arrives. -->
      <div class="cg-center-skeleton" id="cgCenterSkeleton" style="display:{{#isresuming}}block{{/isresuming}}{{^isresuming}}none{{/isresuming}}">{{> local_coursegen/courseai_skeleton_cards }}</div>

      <!-- Streaming content containers (hidden initially, shown as content arrives) -->
      <div class="planning-stream-content" id="planningStreamContent" style="display:none">
        <div id="planSectionsView" style="display:none">
          <div id="planSectionsList"></div>
        </div>
        <div id="planDetailedView" style="display:none">
          <div id="planDetailedList"></div>
        </div>
        <div id="planMarkdownView" style="display:none">
          <div class="plan-markdown" id="planMarkdown"></div>
          <span class="typing-cursor hidden" id="typingCursor"></span>
        </div>
      </div>

      <div class="pc-completion-card" id="completionView" style="display:none">
