{{!
    @template local_coursegen/activity_type_picker

    The steps of the activity modal that come after the chooser of types: the kinds of H5P, and the bar that shows what
    was picked.

    Context variables required for this template:
    * h5ptypes array  - The H5P kinds: type, name, usesimages.

    Example context (json):
    {
        "h5ptypes": [
            {"type": "question_set", "name": "Question Set", "usesimages": false}
        ]
    }
}}
<div class="local_coursegen_type_picker" data-region="local_coursegen/activity/typepicker">
    <div data-region="local_coursegen/activity/chosen" class="d-none align-items-center justify-content-between mb-3 p-2 border rounded bg-light">
        <span data-region="local_coursegen/activity/chosen_label"></span>
        <a href="#" data-action="local_coursegen/activity/change-type" class="small">{{#str}} activitytype_change, local_coursegen {{/str}}</a>
    </div>

    <div data-region="local_coursegen/activity/h5plist" class="d-none">
        <h5 class="mb-1">{{#str}} h5ptype_title, local_coursegen {{/str}}</h5>
        <p class="text-muted">{{#str}} h5ptype_intro, local_coursegen {{/str}}</p>
        <div class="row">
            <div class="col-12 col-md-6 col-xl-4 mb-3">
                <button type="button" class="btn btn-outline-primary w-100 h-100 text-left"
                        data-action="local_coursegen/activity/pick-h5ptype" data-type="">
                    <strong class="d-block">{{#str}} h5ptype_auto, local_coursegen {{/str}}</strong>
                    <small class="d-block text-muted">{{#str}} h5ptype_autodesc, local_coursegen {{/str}}</small>
                </button>
            </div>
            {{#h5ptypes}}
            <div class="col-12 col-md-6 col-xl-4 mb-3">
                <button type="button" class="btn btn-outline-secondary w-100 h-100 text-left"
                        data-action="local_coursegen/activity/pick-h5ptype" data-type="{{type}}">
                    <strong class="d-block">{{name}}</strong>
                    {{#usesimages}}<small class="d-block text-muted">{{#str}} h5ptype_usesimages, local_coursegen {{/str}}</small>{{/usesimages}}
                </button>
            </div>
            {{/h5ptypes}}
        </div>
        <a href="#" data-action="local_coursegen/activity/change-type">{{#str}} h5ptype_back, local_coursegen {{/str}}</a>
    </div>
</div>
