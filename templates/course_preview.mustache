{{!
    @template local_coursegen/course_preview

    The course a generation will produce, laid out as a course page.

    Nothing that draws a real course page can draw this, because the course does
    not exist: those renderers all begin from a course id. So the markup is
    core_courseformat's own, section card and activity row alike, which is what
    makes it read as the course it is going to be rather than as a list.

    Activities the AI writes link to their own preview; the ones copied from the
    base course do not, because they already exist there unchanged.

    Context variables required for this template:
    * sections array - [{name, activitycount, activities: [{name, modname, purpose,
      iconhtml, typelabel, aigenerated, summary, previewurl}]}]

    Example context (json):
    {
        "sections": [
            {
                "name": "Módulo #1",
                "activitycount": 1,
                "activities": [
                    {
                        "name": "Lección 1",
                        "modname": "lesson",
                        "purpose": "content",
                        "iconhtml": "",
                        "typelabel": "Lección",
                        "aigenerated": true,
                        "summary": "Introducción a los fundamentos de la computación.",
                        "previewurl": "https://example.com/preview"
                    }
                ]
            }
        ]
    }
}}
<div class="course-content cg-course-preview">
  <ul class="course-content-list">
    {{#sections}}
    <li class="section course-section card mb-3">
      <div class="card-body">
        <div class="course-section-header d-flex align-items-center mb-2">
          <h3 class="sectionname course-content-item mb-0 flex-grow-1">{{name}}</h3>
          <span class="cg-section-meta badge bg-light text-muted">{{activitycount}}</span>
        </div>

        <ul class="section m-0 p-0 img-text d-block">
          {{#activities}}
          <li class="activity activity-wrapper {{modname}} modtype_{{modname}}">
            <div class="activity-item focus-control" data-region="activity-card">
              <div class="activity-grid">
                <div class="activity-icon activityiconcontainer smaller {{purpose}} courseicon align-self-start me-2">
                  {{{iconhtml}}}
                </div>
                <div class="activity-name-area activity-instance d-flex flex-column me-2">
                  <div class="activitytitle modtype_{{modname}} position-relative align-self-start">
                    <div class="activityname">
                      {{#previewurl}}
                      <a href="{{previewurl}}" class="aalink" target="_blank" rel="noopener">{{name}}</a>
                      {{/previewurl}}
                      {{^previewurl}}
                      <span class="instancename">{{name}}</span>
                      {{/previewurl}}
                      {{#aigenerated}}
                      <span class="badge badge-light border cg-tpl-instance-badge">
                        {{#str}}courseai_template_instance_badge, local_coursegen{{/str}}
                      </span>
                      {{/aigenerated}}
                    </div>
                  </div>
                  {{#typelabel}}
                  <p class="cg-activity-desc mb-0">{{typelabel}}</p>
                  {{/typelabel}}
                  {{#summary}}
                  <p class="cg-activity-desc mb-0">{{summary}}</p>
                  {{/summary}}
                </div>
              </div>
            </div>
          </li>
          {{/activities}}
        </ul>
      </div>
    </li>
    {{/sections}}
  </ul>
</div>
