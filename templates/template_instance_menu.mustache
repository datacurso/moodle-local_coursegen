{{!
    @template local_coursegen/template_instance_menu

    Body of the single shared floating template picker (see
    local/template/template_instance_menu.js) — lists every activity
    currently marked "Use as template", enabled or disabled depending on
    whether its scope makes it eligible for the section the menu was opened
    from.

    Data attributes required for JS:
    * data-source-cmid + data-source-name + data-type-label on each enabled
      item, read when the admin picks it.

    Context variables required for this template:
    * hasoptions bool  - True when at least one template exists at all.
    * options array    - Each with: sourcecmid int, name string,
                         typelabel string, disabled bool, scopehint string,
                         tooltip string (only meaningful when disabled).

    Example context (json):
    {
        "hasoptions": true,
        "options": [
            {"sourcecmid": 42, "name": "Lesson template", "typelabel": "Lesson", "disabled": false, "scopehint": "this section", "tooltip": ""},
            {"sourcecmid": 43, "name": "Quiz template", "typelabel": "Quiz", "disabled": true, "scopehint": "another section", "tooltip": "Its scope is \"this section only\" and it lives in a different section"}
        ]
    }
}}
{{#hasoptions}}
<p class="tpl-instance-menu-hint">{{#str}} template_instance_menu_hint, local_coursegen {{/str}}</p>
{{#options}}
<button type="button" class="tpl-instance-menu-item"{{#disabled}} disabled title="{{tooltip}}"{{/disabled}}
        {{^disabled}}data-source-cmid="{{sourcecmid}}" data-source-name="{{name}}" data-type-label="{{typelabel}}"{{/disabled}}>
    <span>{{name}}</span>
    <span class="tpl-instance-menu-scope-hint">{{scopehint}}</span>
</button>
{{/options}}
{{/hasoptions}}
{{^hasoptions}}
<p class="tpl-instance-menu-hint mb-0">{{#str}} template_instance_menu_empty, local_coursegen {{/str}}</p>
{{/hasoptions}}
