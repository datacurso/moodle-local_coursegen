{{!
    @template local_coursegen/preview_paragraphs

    A list of plain paragraphs, shared by every previewed module that used to
    build them one html_writer::tag('p', ...) call at a time.

    Context variables required for this template:
    * classes - string.
    * paragraphs - array of {text}.
}}
{{#paragraphs}}
<p class="{{classes}}">{{{text}}}</p>
{{/paragraphs}}
