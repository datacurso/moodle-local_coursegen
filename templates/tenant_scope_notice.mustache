{{!
    @template local_coursegen/tenant_scope_notice

    Read-only notice shown at the top of every plugin configuration page,
    naming the tenant the settings apply to, with an optional page description.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * message string       - Localised notice naming the current tenant (HTML-safe, the tenant name is formatted).
    * hasdescription bool  - Whether a page description is shown.
    * description string   - Localised page description, only when hasdescription is true.

    Example context (json):
    {
        "message": "These settings only apply to the tenant \"Tenant A\"",
        "hasdescription": true,
        "description": "Manage the system instructions used as course guidelines."
    }
}}
<div class="local_coursegen-tenant_scope_notice mb-3" data-region="local_coursegen/tenant-scope-notice">
    <div class="alert alert-warning d-flex align-items-center mb-2" role="status">
        {{#pix}} i/info, core {{/pix}}
        <strong class="ml-2">{{{message}}}</strong>
    </div>
    {{#hasdescription}}
        <p class="text-muted mb-0">{{description}}</p>
    {{/hasdescription}}
</div>
