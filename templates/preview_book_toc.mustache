{{!
    @template local_coursegen/preview_book_toc

    A previewed book's table of contents, ported from
    mod/book/locallib.php book_get_toc(). A book nests chapters one level
    deep, into subchapters, which is why this template is two loops rather
    than a recursive one.

    Context variables required for this template:
    * numberingclass - string, one of the book_toc_* classes.
    * chapters - array of {id, title, titleunescaped, cssclass, iscurrent,
                 url, hassubchapters, subchapters}. Each subchapter has the
                 same {id, title, titleunescaped, cssclass, iscurrent, url}
                 shape.

    Example context (json):
    {
        "numberingclass": "book_toc_numbered",
        "chapters": [
            {
                "id": 1,
                "title": "1. Introduction",
                "titleunescaped": "1. Introduction",
                "cssclass": "bookprev",
                "iscurrent": true,
                "url": "https://example.com/mod/book/view.php?chapterid=1",
                "hassubchapters": true,
                "subchapters": [
                    {
                        "id": 2,
                        "title": "1.1 Goals",
                        "titleunescaped": "1.1 Goals",
                        "cssclass": "bookprev",
                        "iscurrent": false,
                        "url": "https://example.com/mod/book/view.php?chapterid=2"
                    }
                ]
            },
            {
                "id": 3,
                "title": "2. Methods",
                "titleunescaped": "2. Methods",
                "cssclass": "bookprev",
                "iscurrent": false,
                "url": "https://example.com/mod/book/view.php?chapterid=3",
                "hassubchapters": false,
                "subchapters": []
            }
        ]
    }
}}
<div class="book_toc {{numberingclass}} clearfix">
    <ul>
        {{#chapters}}
        <li>
            {{#iscurrent}}<strong class="{{cssclass}}">{{{title}}}</strong>{{/iscurrent}}
            {{^iscurrent}}<a href="{{{url}}}" title="{{titleunescaped}}" class="{{cssclass}}">{{{title}}}</a>{{/iscurrent}}
            {{#hassubchapters}}
            <ul>
                {{#subchapters}}
                <li>
                    {{#iscurrent}}<strong class="{{cssclass}}">{{{title}}}</strong>{{/iscurrent}}
                    {{^iscurrent}}<a href="{{{url}}}" title="{{titleunescaped}}" class="{{cssclass}}">{{{title}}}</a>{{/iscurrent}}
                </li>
                {{/subchapters}}
            </ul>
            {{/hassubchapters}}
        </li>
        {{/chapters}}
    </ul>
</div>
