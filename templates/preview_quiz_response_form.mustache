{{!
    @template local_coursegen/preview_quiz_response_form

    The form a previewed quiz's questions are printed inside, which is the
    markup the questions' own scripts expect.

    Context variables required for this template:
    * action - string.
    * questionshtml - string, already-rendered HTML from the question engine.
}}
<form action="{{{action}}}" method="post" enctype="multipart/form-data" accept-charset="utf-8" id="responseform">
    <div>{{{questionshtml}}}</div>
</form>
