{{!
    @template local_coursegen/presentation_editor

    The editor of a Course Presentation: the general instruction for the AI and the slides laid out as they will look.
    Each element of a slide is an instruction for the AI or something fixed.

    Context variables required for this template:
    * error string, topic string, name string
    * manual bool, auto bool, min int, max int, languages array (code, name, selected)
    * hasfile bool, filename string
    * busy bool, busyall bool, creating bool
    * slides array          - The thumbnails: index, number, current, title, mini (hastitle, hastext, hasimage, hasquestion, hasvideo).
    * current object        - The selected slide: number, total, first, last, blocks, addchips.

    Example context (json):
    {"error": "", "topic": "", "name": "", "manual": true, "auto": false, "min": 5, "max": 8,
     "languages": [], "hasfile": false, "filename": "", "busy": false, "busyall": false, "creating": false, "slides": [], "total": 0}
}}
<div class="local_coursegen_pe">
    <div class="pe-brief">
        <label class="pe-cap" for="pe-topic"><i class="fa fa-magic" aria-hidden="true"></i>{{#str}} pe_ctx_label, local_coursegen {{/str}}</label>
        <div class="pe-composer {{#topicError}}is-invalid{{/topicError}}">
            <textarea id="pe-topic" class="pe-composer-text" rows="3" data-field="topic" {{#topicError}}aria-invalid="true" aria-describedby="pe-topic-error"{{/topicError}}
                      placeholder="{{#str}} pe_ctx_placeholder, local_coursegen {{/str}}">{{topic}}</textarea>
            <div class="pe-composer-bar">
                <button type="button" class="pe-round" data-action="local_coursegen/pe/attach"
                        title="{{#str}} pe_attach, local_coursegen {{/str}}" aria-label="{{#str}} pe_attach, local_coursegen {{/str}}"><i class="fa fa-paperclip" aria-hidden="true"></i></button>
                {{#hasfile}}
                <span class="pe-file">
                    <span class="pe-truncate">{{filename}}</span>
                    <button type="button" class="pe-icon" data-action="local_coursegen/pe/removefile"
                            title="{{#str}} pe_remove_file, local_coursegen {{/str}}" aria-label="{{#str}} pe_remove_file, local_coursegen {{/str}}"><i class="fa fa-times" aria-hidden="true"></i></button>
                </span>
                {{/hasfile}}
                <label class="pe-lang">
                    <select class="custom-select custom-select-sm" data-field="lang" aria-label="{{#str}} pe_lang, local_coursegen {{/str}}">
                        {{#languages}}<option value="{{code}}" {{#selected}}selected{{/selected}}>{{name}}</option>{{/languages}}
                    </select>
                </label>
            </div>
        </div>
        {{#topicError}}<p class="pe-error" id="pe-topic-error" data-error-for="topic">{{.}}</p>{{/topicError}}
    </div>

    <div class="pe-slides-head">
        <h3 class="pe-h">{{#str}} pe_strip, local_coursegen {{/str}}</h3>
        <div class="pe-seg" role="radiogroup" aria-label="{{#str}} pe_strip, local_coursegen {{/str}}">
            <label class="{{#manual}}is-on{{/manual}}"><input type="radio" name="pe-mode" data-field="mode" value="manual" {{#manual}}checked{{/manual}}>{{#str}} pe_mode_manual, local_coursegen {{/str}}</label>
            <label class="{{#auto}}is-on{{/auto}}"><input type="radio" name="pe-mode" data-field="mode" value="auto" {{#auto}}checked{{/auto}}>{{#str}} pe_mode_auto, local_coursegen {{/str}}</label>
        </div>
        {{#auto}}
        <div class="pe-range">
            <span>{{#str}} pe_range_between, local_coursegen {{/str}}</span>
            <input type="number" min="3" max="30" data-field="min" class="form-control form-control-sm {{#rangeError}}is-invalid{{/rangeError}}" {{#rangeError}}aria-invalid="true"{{/rangeError}} value="{{min}}" aria-label="{{#str}} pe_range_min, local_coursegen {{/str}}">
            <span>{{#str}} pe_range_and, local_coursegen {{/str}}</span>
            <input type="number" min="3" max="30" data-field="max" class="form-control form-control-sm {{#rangeError}}is-invalid{{/rangeError}}" {{#rangeError}}aria-invalid="true"{{/rangeError}} value="{{max}}" aria-label="{{#str}} pe_range_max, local_coursegen {{/str}}">
            <span>{{#str}} pe_range_unit, local_coursegen {{/str}}</span>
        </div>
        {{/auto}}
    </div>
    {{#rangeError}}<p class="pe-error" data-error-for="range">{{.}}</p>{{/rangeError}}

    {{#manual}}
    <div class="pe-work {{^total}}is-empty{{/total}}">
        {{#total}}
        <div class="pe-rail" role="group" aria-label="{{#str}} pe_strip, local_coursegen {{/str}}">
            {{#slides}}
            <div class="pe-thumb-wrap" draggable="true" data-drag-slide="{{index}}">
                <button type="button" class="pe-thumb {{#current}}is-active{{/current}}" data-action="local_coursegen/pe/select" data-index="{{index}}"
                        title="{{title}}" {{#current}}aria-current="true"{{/current}}>
                    <span class="pe-thumb-no">{{number}}</span>
                    <span class="pe-mini">
                        {{#mini.hastitle}}<i class="pe-sk pe-sk-title"></i>{{/mini.hastitle}}
                        {{#mini.hastext}}<i class="pe-sk"></i><i class="pe-sk pe-sk-short"></i>{{/mini.hastext}}
                        {{#mini.hasimage}}<i class="pe-sk pe-sk-image"></i>{{/mini.hasimage}}
                        {{#mini.hasvideo}}<i class="pe-sk pe-sk-image"></i>{{/mini.hasvideo}}
                        {{#mini.hasquestion}}<i class="pe-sk pe-sk-box"></i>{{/mini.hasquestion}}
                    </span>
                </button>
            </div>
            {{/slides}}
            <button type="button" class="pe-addslide {{#slidesError}}is-invalid{{/slidesError}}" {{#slidesError}}aria-invalid="true"{{/slidesError}} data-action="local_coursegen/pe/addslide">
                <i class="fa fa-plus" aria-hidden="true"></i>{{#str}} pe_add, local_coursegen {{/str}}
            </button>
        </div>
        {{/total}}

        <div class="pe-stage">
            {{#slidesError}}<p class="pe-error" data-error-for="slides">{{.}}</p>{{/slidesError}}
            {{#current}}
            <div class="pe-slidebar">
                <span class="pe-count">{{#str}} pe_slide_of, local_coursegen, {"number": {{number}}, "total": {{total}}} {{/str}}</span>
                <div class="dropdown pe-menu">
                <button type="button" class="btn btn-icon dropdown-toggle no-caret pe-menu-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                        title="{{#str}} pe_slide_options, local_coursegen {{/str}}" aria-label="{{#str}} pe_slide_options, local_coursegen {{/str}}"><i class="fa fa-ellipsis-v" aria-hidden="true"></i></button>
                <div class="dropdown-menu dropdown-menu-right">
                        <button type="button" class="dropdown-item" data-action="local_coursegen/pe/sdup">{{#str}} cpb_duplicate, local_coursegen {{/str}}</button>
                        <button type="button" class="dropdown-item text-danger" data-action="local_coursegen/pe/sdel">{{#str}} cpb_remove, local_coursegen {{/str}}</button>
                    </div>
            </div>
            </div>
            <div class="pe-canvas">
                <div class="pe-slide">
                    {{#blocks}}{{> local_coursegen/presentation_editor_block}}{{/blocks}}
                </div>
            </div>
            <label class="pe-add-element">
                <span class="sr-only">{{#str}} pe_add_element, local_coursegen {{/str}}</span>
                <select data-field="addtype" class="custom-select custom-select-sm {{#slideError}}is-invalid{{/slideError}}" {{#slideError}}aria-invalid="true"{{/slideError}}>
                    <option value="">{{#str}} pe_add_element, local_coursegen {{/str}}</option>
                    {{#addchips}}<option value="{{type}}">{{label}}</option>{{/addchips}}
                </select>
            </label>
            {{#slideError}}<p class="pe-error" data-error-for="slide">{{.}}</p>{{/slideError}}
            {{/current}}
            {{^current}}
            <div class="pe-empty">
                <p class="pe-empty-title {{#slidesError}}is-invalid{{/slidesError}}" {{#slidesError}}aria-invalid="true" tabindex="-1"{{/slidesError}}>{{#str}} pe_empty, local_coursegen {{/str}}</p>
                <div class="pe-layouts">
                    <button type="button" class="pe-layout" data-action="local_coursegen/pe/addslide" data-layout="cover">
                        <span class="pe-lpv"><i class="pe-sk pe-sk-title"></i><i class="pe-sk"></i><i class="pe-sk pe-sk-image"></i></span>{{#str}} pe_layout_cover, local_coursegen {{/str}}
                    </button>
                    <button type="button" class="pe-layout" data-action="local_coursegen/pe/addslide" data-layout="content">
                        <span class="pe-lpv"><i class="pe-sk pe-sk-title"></i><i class="pe-sk"></i><i class="pe-sk pe-sk-short"></i></span>{{#str}} pe_layout_content, local_coursegen {{/str}}
                    </button>
                    <button type="button" class="pe-layout" data-action="local_coursegen/pe/addslide" data-layout="split">
                        <span class="pe-lpv"><i class="pe-sk pe-sk-title"></i><span class="pe-lcols"><i class="pe-sk"></i><i class="pe-sk pe-sk-image"></i></span></span>{{#str}} pe_layout_split, local_coursegen {{/str}}
                    </button>
                    <button type="button" class="pe-layout" data-action="local_coursegen/pe/addslide" data-layout="question">
                        <span class="pe-lpv"><i class="pe-sk pe-sk-title"></i><i class="pe-sk pe-sk-box"></i></span>{{#str}} pe_layout_question, local_coursegen {{/str}}
                    </button>
                </div>
            </div>
            {{/current}}
        </div>
    </div>
    {{/manual}}
    {{#auto}}
    <div class="pe-auto"><i class="fa fa-magic" aria-hidden="true"></i><p>{{#str}} pe_auto_note, local_coursegen {{/str}}</p></div>
    {{/auto}}

    <div class="pe-final">
        {{#error}}<div class="pe-alert" role="alert" data-region="local_coursegen/pe/error">{{error}}</div>{{/error}}
        <div class="pe-final-row">
            <span class="pe-grow"></span>
            <button type="button" class="pe-btn pe-btn-primary" data-action="local_coursegen/pe/create" {{#busy}}disabled{{/busy}}>
                {{#busy}}<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>{{/busy}}
                {{#str}} pe_create, local_coursegen {{/str}}
            </button>
        </div>
    </div>
</div>
