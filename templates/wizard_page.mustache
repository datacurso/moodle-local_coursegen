{{!
    @template local_coursegen/wizard_page

    AI Course Creation Wizard - Step 1: Context

    Example context (json):
    {
        "guidelines": "[{\"id\":\"si_1\",\"name\":\"Example\",\"category\":\"General\",\"description\":\"...\"}]",
        "languages": "[{\"code\":\"es\",\"name\":\"Español (es)\"}]",
        "defaultlang": "es"
    }
}}

{{! Wizard CSS will be loaded via PHP $PAGE->requires->css() }}

<!-- ══════════════════════ HEADER ══════════════════════════════════════ -->
<header class="app-header">
  <div class="container">
    <div class="header-inner">

      <!-- Logo -->
      <div class="logo">
        <img src="{{logourl}}" alt="Datacurso Logo" />
      </div>

      <div class="header-text">
        <h1>Datacurso course creator AI</h1>
        <p>Crea cursos completos en Moodle con IA, en minutos</p>
      </div>

    </div>
  </div>
</header>

<!-- ══════════════════════ MAIN ════════════════════════════════════════ -->
<main class="app-main">
  <div class="container">

    <!-- Step header -->
    <div class="step-header">
      <ol class="steps-list">

        <li class="step-item active" data-step="context">
          <div class="step-circle">1</div>
          <span class="step-label">Contexto</span>
        </li>
        <div class="step-connector" role="presentation"></div>

        <li class="step-item pending" data-step="planning">
          <div class="step-circle">2</div>
          <span class="step-label">Planificación inicial</span>
        </li>
        <div class="step-connector" role="presentation"></div>

        <li class="step-item pending" data-step="detailed">
          <div class="step-circle">3</div>
          <span class="step-label">Planificación detallada</span>
        </li>
        <div class="step-connector" role="presentation"></div>

        <li class="step-item pending" data-step="generating">
          <div class="step-circle">4</div>
          <span class="step-label">Generación</span>
        </li>

      </ol>
    </div>

    <!-- Context step form -->
    <div class="context-wrap" id="contextView">

      <div class="context-head">
        <h2>¿Qué curso quieres crear?</h2>
        <p>Describe el curso y, si quieres, adjunta el sílabo o aplica directrices institucionales.</p>
      </div>

      <!-- Card -->
      <div class="card" id="mainCard">

        <!-- Prompt textarea -->
        <textarea
          id="promptInput"
          class="prompt-textarea"
          placeholder="Ej: Crea un curso introductorio de Python para primer ciclo de ingeniería, 8 semanas, con énfasis en pensamiento computacional y ejercicios prácticos cada semana…"
          rows="5"
          aria-label="Descripción del curso"
        ></textarea>

        <!-- Selected chips (syllabus + guideline) -->
        <div class="chips-row" id="chipsRow" style="display:none">

          <!-- Syllabus chip (shown after file attach) -->
          <span class="chip chip-syllabus hidden" id="chipSyllabus">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z"/>
              <polyline points="14 2 14 8 20 8"/>
              <line x1="16" y1="13" x2="8" y2="13"/>
              <line x1="16" y1="17" x2="8" y2="17"/>
            </svg>
            <span class="chip-name" id="chipSyllabusName"></span>
            <button class="chip-btn" onclick="clearSyllabus()" aria-label="Quitar sílabo">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </span>

          <!-- Guideline chip (shown after selecting a guideline) -->
          <span class="chip chip-guideline hidden" id="chipGuideline">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <polyline points="9 12 11 14 15 10"/>
            </svg>
            <span class="chip-name" id="chipGuidelineName"></span>
            <button class="chip-btn" id="chipGuidelineEyeBtn" aria-label="Ver directriz">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
              </svg>
            </button>
            <button class="chip-btn" onclick="clearGuideline()" aria-label="Quitar directriz">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" aria-hidden="true">
                <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
              </svg>
            </button>
          </span>

        </div>

        <!-- Bottom toolbar -->
        <div class="card-toolbar">
          <div class="tbar-left">

            <!-- Sílabo button -->
            <button class="tbar-btn" id="btnSyllabus" title="Adjuntar sílabo (PDF, DOCX, TXT)" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
              </svg>
              Sílabo
            </button>
            <!-- Hidden file manager container for Moodle file picker -->
            <div class="hidden" id="syllabusFilemanager"></div>

            <div class="tbar-sep" role="separator"></div>

            <!-- Directrices button + popover -->
            <div class="popover-wrap">
              <button class="tbar-btn" id="btnDirectrices" title="Directrices institucionales" type="button">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <polyline points="9 12 11 14 15 10"/>
                </svg>
                Directrices
                <span class="guideline-badge hidden" id="guidelineBadge"></span>
              </button>

              <!-- Popover panel -->
              <div class="popover-panel" id="guidelinesPopover" role="dialog" aria-label="Directrices institucionales">
                <div class="pop-search-row">
                  <div class="pop-search-inner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="11" cy="11" r="8"/>
                      <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input type="text" id="guidelineSearch" placeholder="Buscar directriz…" autocomplete="off" />
                  </div>
                  <p class="pop-note">Solo puedes aplicar una directriz por curso.</p>
                </div>
                <ul class="pop-list" id="guidelineList" role="listbox" aria-label="Lista de directrices"></ul>
              </div>
            </div>

            <div class="tbar-sep" role="separator"></div>

            <!-- Language selector -->
            <select class="tbar-select" id="langSelect" title="Idioma del curso" aria-label="Idioma">
              <option value="es">🌐 ES</option>
              <option value="en">🌐 EN</option>
            </select>

            <div class="tbar-sep" role="separator"></div>

            <!-- With images toggle switch -->
            <label class="tbar-toggle-wrap" title="Incluir sugerencias de imágenes en el curso">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0">
                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
              <span class="tbar-toggle-label">Imágenes</span>
              <div class="toggle-track" id="imgToggleTrack">
                <div class="toggle-thumb"></div>
              </div>
              <input type="checkbox" id="btnWithImages" class="hidden" aria-label="Incluir imágenes" />
            </label>

          </div>

          <div class="tbar-right">
            <span class="kbd-hint">↵ para generar</span>
            <button class="btn-generate" id="btnGenerate" type="button">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/>
              </svg>
              Generar
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 19V5M5 12l7-7 7 7"/>
              </svg>
            </button>
          </div>
        </div>

      </div><!-- .card -->

      <p class="form-tip">Tip: sé específico con tema, nivel, duración y objetivos para una mejor planificación.</p>

    </div><!-- .context-wrap -->

    <!-- Step 2: Planning view -->
    <div class="planning-wrap" id="planningView" style="display:none">
      <div class="pc-card">
        <div class="pc-card-main">
          <div class="pc-icon-wrap">
            <svg id="planningSpinner" class="pc-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
          </div>

          <div class="pc-info">
            <span class="pc-step" id="pcStep">Planificando…</span>
            <h3 class="pc-title" id="pcTitle">Diseñando la estructura del curso</h3>
            <p class="pc-subtitle" id="pcSubtitle"></p>

            <div class="pc-progress-wrap">
              <div class="pc-progress-row">
                <span class="pc-progress-label">Progreso</span>
                <span class="pc-progress-pct" id="pcPct">0%</span>
              </div>
              <div class="pc-bar-track">
                <div class="pc-bar-fill" id="pcBarFill" style="width:0%"></div>
              </div>
            </div>
          </div>
        </div>

        <div class="pc-toggle-row" id="pcToggleRow" style="display:none">
          <button class="pc-toggle-btn" id="pcToggleBtn" type="button">
            <svg class="pc-chevron" id="pcChevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"/>
            </svg>
            Ver detalles del avance
          </button>
        </div>

        <div class="pc-details-panel" id="pcDetailsPanel" style="display:none">
          <div id="planSectionsView" style="display:none">
            <div id="planSectionsList"></div>
          </div>

          <div id="planDetailedView" style="display:none">
            <div id="planDetailedList"></div>
          </div>

          <div id="planMarkdownView" style="display:none">
            <div class="plan-markdown" id="planMarkdown"></div>
            <span class="typing-cursor hidden" id="typingCursor"></span>
          </div>
        </div>
      </div>

      <div class="prv-card" id="planReviewCard" style="display:none">
        <div class="prv-header prv-header--stream" id="prvHeader">
          <span class="prv-icon-wrap" id="prvIconWrap">
            <svg id="prvSpinnerIcon" class="prv-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
              <path d="M21 12a9 9 0 1 1-6.219-8.56"/>
            </svg>
            <svg id="prvCheckIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </span>
          <div class="prv-header-text">
            <h2 class="prv-header-title" id="prvHeaderTitle">Diseñando la estructura del curso</h2>
            <p class="prv-header-sub" id="prvHeaderSub">Iniciando...</p>
            <p class="prv-header-sub" id="prvLiveNote" style="display:none">Mostrando avance en tiempo real de la planificación detallada.</p>
          </div>
        </div>
        <div class="prv-sections" id="prvSections"></div>
      </div>

      <div class="plan-actions" id="planActions" style="display:none">
        <p class="plan-action-hint" id="planActionsHint">Aprueba la estructura para continuar o solicita ajustes.</p>
        <div class="plan-action-btns">
          <button class="btn-plan-adjust" id="btnAdjust" type="button">Ajustar</button>
          <button class="btn-plan-approve" id="btnApprove" type="button">Aprobar</button>
        </div>
      </div>

      <div class="adjust-panel" id="adjustPanel" style="display:none">
        <textarea class="adjust-textarea" id="adjustInput" placeholder="Indicá qué querés ajustar en la planificación..."></textarea>
        <div class="adjust-actions">
          <button class="btn-adjust-cancel" id="btnAdjustCancel" type="button">Cancelar</button>
          <button class="btn-adjust-send" id="btnAdjustSend" type="button">Enviar ajuste</button>
        </div>
      </div>

      <div class="pc-cancel-row" id="planningNavRow">
        <button class="pc-cancel-btn" id="btnBackFlow" type="button">← Volver al contexto</button>
        <button class="pc-cancel-btn" id="btnCancelFlow" type="button">Cancelar</button>
      </div>
    </div>

  </div><!-- .container -->
</main>

<!-- Guideline preview modal (Bootstrap 4) -->
<div class="modal fade" id="guidelinePreviewModal" tabindex="-1" role="dialog" aria-labelledby="previewModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered preview-dialog" role="document">
    <div class="modal-content preview-modal-content">

      <!-- Circle-X close button (top right) -->
      <button type="button" class="preview-close" data-dismiss="modal" aria-label="Cerrar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
        </svg>
      </button>

      <!-- Header -->
      <div class="preview-header">
        <div class="preview-title">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary);flex-shrink:0" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>
          </svg>
          <span id="previewModalLabel"></span>
        </div>
        <div class="preview-subtitle">
          <span class="preview-cat-badge" id="previewModalCategory"></span>
          <span class="preview-subtitle-text">Contenido completo que se enviará a la IA como contexto.</span>
        </div>
      </div>

      <!-- Description box -->
      <div class="preview-body">
        <div class="preview-desc-box">
          <p id="previewModalBody"></p>
        </div>
      </div>

    </div>
  </div>
</div>

{{! Data passed to JavaScript }}
<div id="wizard-data" style="display:none" 
     data-guidelines="{{{guidelines}}}" 
     data-languages="{{{languages}}}" 
     data-defaultlang="{{defaultlang}}">
</div>
