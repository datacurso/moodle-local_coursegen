{{!
    @template local_coursegen/preview_glossary_lower_section

    A previewed glossary entry's aliases and command icons, ported from
    glossary_print_entry_lower_section().

    Context variables required for this template:
    * show - bool.
    * printseparator - bool.

    Context variables optional for this template:
    * aliasesid - string, required when aliaseshtml is set.
    * aliaseshtml - string, already-rendered HTML.
    * icons - string, already-rendered HTML.
}}
{{#show}}
<table>
    {{#aliaseshtml}}
    <tr valign="top">
        <td class="aliases">
            <label for="{{aliasesid}}">{{#str}} aliases, glossary {{/str}}: </label>{{{aliaseshtml}}}
        </td>
    </tr>
    {{/aliaseshtml}}
    {{#icons}}<tr valign="top"><td class="icons">{{{icons}}}</td></tr>{{/icons}}
</table>
{{#printseparator}}<hr>{{/printseparator}}
{{/show}}
