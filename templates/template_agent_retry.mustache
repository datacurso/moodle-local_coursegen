{{!
    @template local_coursegen/template_agent_retry

    The message a template generation shows when the run stopped for a reason that a new attempt may fix, with the
    button that continues the run from its last checkpoint.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-region="local_coursegen/template-agent/retry" on the card
    * data-action="local_coursegen/template-agent/retry" on the button

    Context variables required for this template:
    * message string - Why the run stopped, for example "The AI service is busy. Please retry."

    Example context (json):
    {
        "message": "The AI service is busy. Please retry."
    }
}}
<div class="local_coursegen-template_agent_retry cg-decision-card cg-ask-card" role="alert"
     data-region="local_coursegen/template-agent/retry">
    <p class="cg-decision-subtitle cg-ask-retry-message">{{message}}</p>
    <div class="cg-decision-actions">
        <button type="button" class="cg-decision-btn cg-decision-btn--accept"
                data-action="local_coursegen/template-agent/retry">
            {{#str}} template_agent_retry_button, local_coursegen {{/str}}
        </button>
    </div>
</div>
