{{!
    @template local_coursegen/system_instruction_list

    List of the system instructions of the current tenant, plus the button to
    add a new one.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * addurl string          - URL of the "Add system instruction" page.
    * hasinstructions bool   - True when instructions is non-empty.
    * instructions array     - Rows with: id int, name string, timecreated int, timemodified int,
                               editurl string, deleteurl string.

    Example context (json):
    {
        "addurl": "https://example.com/local/coursegen/edit_system_instruction.php",
        "hasinstructions": true,
        "instructions": [
            {
                "id": 7,
                "name": "Quality policy",
                "timecreated": 1760000000,
                "timemodified": 1760000000,
                "editurl": "https://example.com/local/coursegen/edit_system_instruction.php?id=7",
                "deleteurl": "https://example.com/local/coursegen/manage_system_instructions.php?action=delete&id=7"
            }
        ]
    }
}}
<div class="local_coursegen-system-instruction-list" data-region="local_coursegen/system-instruction-list">
    <div class="mb-3">
        <a href="{{addurl}}" class="btn btn-secondary">{{#str}} addsysteminstruction, local_coursegen {{/str}}</a>
    </div>
    {{#hasinstructions}}
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">{{#str}} systeminstructionname, local_coursegen {{/str}}</th>
                    <th scope="col">{{#str}} systeminstructioncreated, local_coursegen {{/str}}</th>
                    <th scope="col">{{#str}} systeminstructionmodified, local_coursegen {{/str}}</th>
                    <th scope="col">{{#str}} actions, local_coursegen {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#instructions}}
                    <tr data-instructionid="{{id}}">
                        <td>{{name}}</td>
                        <td>{{#userdate}} {{timecreated}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}</td>
                        <td>{{#userdate}} {{timemodified}}, {{#str}} strftimedatetime, core_langconfig {{/str}} {{/userdate}}</td>
                        <td>
                            <a href="{{editurl}}" title="{{#str}} edit, local_coursegen {{/str}}">{{!
                                }}{{#pix}} t/edit, core, {{#str}} edit, local_coursegen {{/str}} {{/pix}}{{!
                            }}</a>
                            <a href="{{deleteurl}}" title="{{#str}} delete, local_coursegen {{/str}}">{{!
                                }}{{#pix}} t/delete, core, {{#str}} delete, local_coursegen {{/str}} {{/pix}}{{!
                            }}</a>
                        </td>
                    </tr>
                {{/instructions}}
            </tbody>
        </table>
    {{/hasinstructions}}
    {{^hasinstructions}}
        <div class="alert alert-info mt-3" role="status">{{#str}} nosysteminstructions, local_coursegen {{/str}}</div>
    {{/hasinstructions}}
</div>
