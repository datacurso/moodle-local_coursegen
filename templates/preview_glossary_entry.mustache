{{!
    @template local_coursegen/preview_glossary_entry

    A previewed glossary entry, ported from
    glossary_show_entry_dictionary().

    Context variables required for this template:
    * concepthtml, definitionhtml, tagshtml, lowersectionhtml - string,
      already-rendered HTML.
}}
<table class="glossarypost dictionary" cellspacing="0">
    <tr valign="top">
        <td class="entry">
            <div class="concept">{{{concepthtml}}}</div>
            {{{definitionhtml}}}
            {{{tagshtml}}}
        </td>
    </tr>
    <tr valign="top">
        <td class="entrylowersection">{{{lowersectionhtml}}}</td>
    </tr>
</table>
