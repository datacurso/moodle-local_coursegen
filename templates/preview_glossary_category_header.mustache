{{!
    @template local_coursegen/preview_glossary_category_header

    The group-break row a previewed glossary's entry list opens each letter
    (or category) with.

    Context variables required for this template:
    * headinghtml - string, already-rendered HTML.
}}
<div>
    <table cellspacing="0" class="glossarycategoryheader">
        <tr>
            <th>{{{headinghtml}}}</th>
        </tr>
    </table>
</div>
