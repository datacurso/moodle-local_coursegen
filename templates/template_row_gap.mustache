{{!
    @template local_coursegen/template_row_gap

    The thin hover-reveal "+" strip between two adjacent rows, opening the
    template-instance picker at that insertion point.
    template_course_sections_row.mustache includes this for every non-last
    row, and template_instance_rows.js (insertInstanceRow/removeInstanceRow)
    renders the same markup client-side to keep exactly one of these
    between any two rows as instances are added or removed.

    No context variables — the trigger's own title comes straight from a
    language string.
}}
<tr class="tpl-row-gap" data-region="row-gap">
    <td colspan="4">
        <div class="tpl-row-gap-line">
            <div class="dropdown tpl-instance-dropdown">
                <button type="button" class="tpl-row-gap-plus" data-instance-menu-trigger
                        data-toggle="dropdown"
                        aria-haspopup="true" aria-expanded="false"
                        title="{{#str}} template_add_instance, local_coursegen {{/str}}">+</button>
                <div class="dropdown-menu tpl-instance-menu" role="menu"></div>
            </div>
        </div>
    </td>
</tr>
