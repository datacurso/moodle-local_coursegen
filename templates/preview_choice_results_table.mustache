{{!
    @template local_coursegen/preview_choice_results_table

    A previewed choice's named, vertical-layout results table, ported from
    mod/choice/renderer.php display_publish_name_vertical(). Nobody has
    answered a choice being previewed, so the "who chose this option" row is
    always empty cells.

    Context variables required for this template:
    * showform - bool.
    * action - string.
    * coursemoduleid - int.
    * sesskey - string.
    * summary - string.
    * columns - array of {headertitle, mastercheckboxhtml, usernumbertext},
                one per option.
    * actiondata - string, already-rendered HTML, or empty.
}}
<div>
    {{#showform}}
    <form method="POST" action="{{{action}}}" id="attemptsform">
        <input type="hidden" name="id" value="{{coursemoduleid}}">
        <input type="hidden" name="sesskey" value="{{sesskey}}">
        <input type="hidden" name="mode" value="overview">
    {{/showform}}
    <div class="response">
        <table cellpadding="0" cellspacing="0" class="results names table table-bordered" summary="{{summary}}">
            <tr>
                <th scope="row" class="data">{{#str}} choiceoptions, choice {{/str}}</th>
                {{#columns}}
                <th class="header data"><div class="text-center">{{{headertitle}}}{{{mastercheckboxhtml}}}</div></th>
                {{/columns}}
            </tr>
            <tr>
                <th scope="row" class="header data">{{#str}} numberofuser, choice {{/str}}</th>
                {{#columns}}
                <td class="data"><div class="text-center">{{{usernumbertext}}}</div></td>
                {{/columns}}
            </tr>
            <tr>
                <th scope="row" class="header data">{{#str}} userchoosethisoption, choice {{/str}}</th>
                {{#columns}}
                <td class="data"></td>
                {{/columns}}
            </tr>
        </table>
    </div>
    <div class="responseaction">{{{actiondata}}}</div>
    {{#showform}}
    </form>
    {{/showform}}
</div>
